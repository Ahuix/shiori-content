":[{"f":"山田[やまだ]","r":"やまだ","l":"山田"},{"f":"さん","r":"さん","l":"さん"},{"f":"は","r":"は","l":"は"},{"f":"一人[ひとり]","r":"ひとり","l":"一人"},{"f":"で","r":"で","l":"で"},{"f":"店[みせ]","r":"みせ","l":"店"},{"f":"に","r":"に","l":"に"},{"f":"帰[かえ]りました","r":"かえりました","l":"帰る","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"Mr Yamada went back to the shop alone.","zh":"山田先生一个人回到了店里。"},"say":"やまださんは一人で店に帰りました。","b":[{"from":0,"to":2,"r":"topic","h":"topic:は","g":{"en":"as for Mr Yamada","zh":"山田先生"}},{"from":3,"to":4,"r":"adv","g":{"en":"alone","zh":"一个人"},"n":{"en":"一人で \"alone, by oneself\".","zh":"一人で“一个人，独自”。"}},{"from":5,"to":6,"r":"goal","h":"goal:に","g":{"en":"to the shop","zh":"回店里"}},{"from":7,"to":7,"r":"pred","h":"pred","g":{"en":"went back","zh":"回去了"}}]},{"id":"pan-ya/2/9","t":[{"f":"店[みせ]","r":"みせ","l":"店"},{"f":"に","r":"に","l":"に"},{"f":"帰[かえ]った","r":"かえった","l":"帰る","i":{"en":"past","zh":"过去式"}},{"f":"とき","r":"とき","l":"とき"},{"f":"、","p":1},{"f":"ドア","r":"ドア","l":"ドア"},{"f":"の","r":"の","l":"の"},{"f":"前[まえ]","r":"まえ","l":"前"},{"f":"に","r":"に","l":"に"},{"f":"何[なに]か","r":"なにか","l":"何か"},{"f":"が","r":"が","l":"が"},{"f":"ありました","r":"ありました","l":"ある","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"When he got back to the shop, there was something in front of the door.","zh":"他回到店里的时候，发现门前放着什么东西。"},"say":"店に帰ったとき、ドアの前に何かがありました。","g":[{"id":"toki","from":2,"to":3}],"b":[{"from":0,"to":3,"r":"time","h":"time:とき","g":{"en":"when (he) got back to the shop","zh":"回到店里的时候"}},{"from":5,"to":8,"r":"place","h":"place:に","g":{"en":"in front of the door","zh":"在门前"}},{"from":9,"to":10,"r":"subj","h":"subj:が","g":{"en":"something","zh":"某个东西"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"there was","zh":"有"}}]},{"id":"pan-ya/2/10","t":[{"f":"小[ちい]さい","r":"ちいさい","l":"小さい"},{"f":"箱[はこ]","r":"はこ","l":"箱"},{"f":"です","r":"です","l":"です"},{"f":"。","p":1}],"tr":{"en":"It was a small box.","zh":"是一个小盒子。"},"say":"小さい箱です。","b":[{"from":0,"to":2,"r":"pred","h":"pre