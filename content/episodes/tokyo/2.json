:[{"from":7,"to":7,"body":{"en":"どれ \"which one\" is for three or more choices. For two, use どちら.","zh":"どれ（哪一个）用于三个以上的选项。两个之中选一个用どちら。"}}],"who":"lin","b":[{"from":1,"to":6,"r":"topic","h":"topic:は","g":{"en":"as for the one that's most popular","zh":"最受欢迎的"},"n":{"en":"〜のは turns a whole phrase into the topic: いちばん人気があるのは \"the one that is most popular\".","zh":"〜のは把整个短语变成主题：いちばん人気があるのは“最受欢迎的那个”。"}},{"from":7,"to":9,"r":"pred","h":"pred","g":{"en":"which is it?","zh":"是哪个"}}]},{"id":"tokyo/2/7","t":[{"f":"「","p":1},{"f":"これ","r":"これ","l":"これ"},{"f":"です","r":"です","l":"です"},{"f":"。","p":1},{"f":"でも","r":"でも","l":"でも"},{"f":"、","p":1},{"f":"とても","r":"とても","l":"とても"},{"f":"からい","r":"からい","l":"からい"},{"f":"です","r":"です","l":"です"},{"f":"よ","r":"よ","l":"よ"},{"f":"」","p":1}],"tr":{"en":"\"This one. But it's really spicy.\"","zh":"“这个。不过，非常辣哦。”"},"say":"「これです。でも、とてもからいですよ」","who":"ken","b":[{"from":1,"to":2,"r":"pred","h":"pred","g":{"en":"(it) is this one","zh":"是这个"}},{"from":4,"to":4,"r":"conn","g":{"en":"but","zh":"不过"}},{"from":6,"to":6,"r":"adv","g":{"en":"very","zh":"非常"}},{"from":7,"to":9,"r":"pred","h":"pred","g":{"en":"is spicy!","zh":"辣哦"}}]},{"id":"tokyo/2/8","t":[{"f":"「","p":1},{"f":"だいじょうぶ","r":"だいじょうぶ","l":"だいじょうぶ"},{"f":"です","r":"です","l":"です"},{"f":"。","p":1},{"f":"わたし","r":"わたし","l":"わたし"},{"f":"は","r":"は","l":"は"},{"f":"四川[しせん]","r":"しせん","l":"四川"},{"f":"の","r":"の","l":"の"},{"f":"人[ひと]","r":"ひと","l":"人"},{"f":"です","r":"です","l":"です"},{"f":"から","r":"から","l":"から:because"},{"f":"」","p":1}],"tr":{"en":"\"That's fine. I'm from Sichuan.\"","zh":"“没问题。我是四川人嘛。”"},"say":"「だいじょうぶです。わたしはしせんの人ですから」","g":[{"id":"kara-reason","from":9,"to":10}],"n":[{"from":6,"to":6,"body":{"en":"Sichuan, in western China, is famous for very spicy food.","zh":"四川位于中国西部，以麻辣的饮食闻名。"}}],"who":"lin","b":[{"from":1,"to":2,"r":"pred","h":"pred","g":{"en":"it's fine","zh":"没关系"}},{"from":4,"to":5,"r":"topic","h":"topic:は","g":{"en":"as for me","zh":"我"}},{"from":6,"to":10,"r":"pred","h":"pred","g"