":"adv","g":{"en":"alone","zh":"一个人"}},{"from":4,"to":6,"r":"mod","h":"mod","g":{"en":"of making coffee","zh":"煮咖啡的"}},{"from":7,"to":8,"r":"obj","h":"obj:を","g":{"en":"practice","zh":"练习"}},{"from":9,"to":9,"r":"pred","h":"pred","g":{"en":"did","zh":"做了"}}]},{"id":"baito/3/3","t":[{"f":"店長[てんちょう]","r":"てんちょう","l":"店長"},{"f":"は","r":"は","l":"は"},{"f":"それ","r":"それ","l":"それ"},{"f":"を","r":"を","l":"を"},{"f":"見[み]て","r":"みて","l":"見る","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"「","p":1},{"f":"今日[きょう]","r":"きょう","l":"今日"},{"f":"は","r":"は","l":"は"},{"f":"あの","r":"あの","l":"あの"},{"f":"お客[きゃく]さん","r":"おきゃくさん","l":"お客さん"},{"f":"の","r":"の","l":"の"},{"f":"コーヒー","r":"コーヒー","l":"コーヒー"},{"f":"を","r":"を","l":"を"},{"f":"ハルカ","r":"ハルカ","l":"ハルカ"},{"f":"さん","r":"さん","l":"さん"},{"f":"に","r":"に","l":"に"},{"f":"いれさせてあげて","r":"いれさせてあげて","l":"いれる","i":{"en":"causative + 〜てあげる: do for someone + te-form","zh":"使役 ＋ 〜てあげる：为别人做 ＋ て形"}},{"f":"」","p":1},{"f":"と","r":"と","l":"と"},{"f":"ユウキ","r":"ユウキ","l":"ユウキ"},{"f":"君[くん]","r":"くん","l":"君"},{"f":"に","r":"に","l":"に"},{"f":"言[い]いました","r":"いいました","l":"言う","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"The manager saw this and told Yuki, \"Let Haruka make that customer's coffee today.\"","zh":"店长看到后，对祐树说：“今天让遥来给那位客人冲咖啡吧。”"},"say":"店長はそれを見て、「今日はあのお客さんのコーヒーをハルカさんにいれさせてあげて」とユウキ君に言いました。","g":[{"id":"causative","from":17,"to":17}],"n":[{"from":17,"to":17,"body":{"en":"Causative + てあげる \"let (someone) do it, as a favour to them\". The causative here means \"let\", not \"make\".","zh":"使役＋てあげる表示“（为对方着想）让他去做”。这里的使役是“允许”，而不是“强迫”。"}}],"who":"tencho","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the manager","zh":"店长"}},{"from":2,"to":3,"r":"obj","h":"obj:を","g":{"en":"that","zh":"那情景"}},{"from":4,"to":4,"r":"verb","g":{"en":"saw, and","zh":"看到后"}},{"from":7,"to":19,"r":"quote","h":"quote:と","g":{"en":"\"today, let Haruka make that customer's coffee\"","zh":"“今天让遥给那位客人煮咖啡吧”"},"n":{"en":"〜させてあげて \"let (someone)