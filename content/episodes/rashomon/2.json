"その","r":"その","l":"その"},{"f":"かわり","r":"かわり","l":"かわり"},{"f":"に","r":"に","l":"に"},{"f":"わいてきた","r":"わいてきた","l":"わく","i":{"en":"〜てくる: comes ~ing / has been ~ing + past","zh":"〜てくる：…起来／…过来 ＋ 过去式"}},{"f":"の","r":"の","l":"の:nmz"},{"f":"は","r":"は","l":"は"},{"f":"、","p":1},{"f":"この","r":"この","l":"この"},{"f":"老婆[ろうば]","r":"ろうば","l":"老婆"},{"f":"に","r":"に","l":"に"},{"f":"対[たい]する","r":"たいする","l":"対する"},{"f":"、","p":1},{"f":"いや","r":"いや","l":"いや"},{"f":"、","p":1},{"f":"あらゆる","r":"あらゆる","l":"あらゆる"},{"f":"悪[あく]","r":"あく","l":"悪"},{"f":"に","r":"に","l":"に"},{"f":"対[たい]する","r":"たいする","l":"対する"},{"f":"はげしい","r":"はげしい","l":"はげしい"},{"f":"憎[にく]しみ","r":"にくしみ","l":"憎しみ"},{"f":"だった","r":"だった","l":"だ","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"What welled up in its place was a fierce hatred of this old woman — no, of every kind of evil.","zh":"取而代之涌上心头的，是对这个老太婆——不，是对一切罪恶的强烈憎恨。"},"say":"そのかわりにわいてきたのは、この老婆に対する、いや、あらゆる悪に対するはげしい憎しみだった。","g":[{"id":"ni-taishite","from":15,"to":17}],"b":[{"from":0,"to":2,"r":"conn","g":{"en":"instead","zh":"取而代之"}},{"from":3,"to":5,"r":"topic","h":"topic:は","g":{"en":"as for what welled up","zh":"涌上心头的"}},{"from":7,"to":10,"r":"mod","h":"mod","g":{"en":"toward this old woman","zh":"对这个老太婆的"},"n":{"en":"〜に対する＋N \"N toward ~\": 老婆に対する憎しみ \"hatred toward the old woman\".","zh":"〜に対する＋名词表示“对…的…”：老婆に対する憎しみ“对老太婆的憎恨”。"}},{"from":12,"to":12,"r":"call","g":{"en":"no","zh":"不"}},{"from":14,"to":17,"r":"mod","h":"mod","g":{"en":"toward every evil","zh":"对一切罪恶的"}},{"from":18,"to":20,"r":"pred","h":"pred","g":{"en":"was fierce hatred","zh":"是强烈的憎恨"}}]},{"id":"rashomon/2/16","t":[{"f":"死人[しにん]","r":"しにん","l":"死人"},{"f":"の","r":"の","l":"の"},{"f":"髪[かみ]","r":"かみ","l":"髪"},{"f":"を","r":"を","l":"を"},{"f":"抜[ぬ]く","r":"ぬく","l":"抜く"},{"f":"など","r":"など","l":"など"},{"f":"、","p":1},{"f":"下人[げにん]","r":"げにん","l":"下人"},{"f":"に","r":"に","l":"に"},{"f":"は","r":"は","l":"は"},{"f":"許[ゆる]しがたい","r":"ゆるしがたい","l":"許す","i":{"en":"〜がたい: hard to, can hardly","zh":"〜がたい：难以…"}},{"f":"悪[あく]","r":"あく","l":"悪"},{"f":"に","r":"に","l":"に"},{"f":"思[おも]えた","r":"おもえた","l":"思える","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"To pull the hair from the dead seemed to the servant an unforgivable evil.","zh":"拔死人的头发这种事，在仆人看来是不可饶恕的罪恶。"},"say":"死人の髪を抜くなど、下人には許しがたい悪に思えた。","g":[{"id":"gatai","from":10,"to":10}],"n":[{"from":10,"to":10,"body":{"en":"V-stem + がたい \"hard to ~, can hardly ~\" is used with verbs of thinking and feeling: 許しがたい \"unforgivable\", 信じがたい \"hard to believe\". It is more written than 〜にくい.","zh":"动词连用形＋がたい表示“难以…”，多与表示思考、感情的动词连用：許しがたい“不可饶恕”，信じがたい“难以置信”。比〜にくい更书面。"}},{"from":5,"to":5,"body":{"en":"など after something shows contempt, \"something like ~\": 死人の髪を抜くなど \"pulling the hair off the dead, of all things\".","zh":"など在这里带有轻蔑语气，“…之类的（事）”：死人の髪を抜くなど“居然拔死人的头发”。"}}],"b":[{"from":0,"to":5,"r":"topic","g":{"en":"pulling out the hair of the dead","zh":"拔死人的头发这种事"}},{"from":7,"to":9,"r":"topic","h":"topic:には","g":{"en":"as for to the servant","zh":"在仆人看来"}},{"from":10,"to":10,"r":"mod","h":"mod","g":{"en":"unforgivable","zh":"不可饶恕的"},"n":{"en":"V-stem＋がたい \"hard to ~\": 許しがたい \"unforgivable\".","zh":"动词连用形＋がたい表示“难以…”：許しがたい“不可饶恕”。"}},{"from":11,"to":12,"r":"result","h":"result:に","g":{"en":"an evil","zh":"罪恶"}},{"from":13,"to":13,"r":"pred","h":"pred","g":{"en":"seemed","zh":"觉得是"}}]},{"id":"rashomon/2/17","t":[{"f":"今[いま]","r":"いま","l":"今"},{"f":"なら","r":"なら","l":"なら"},{"f":"、","p":1},{"f":"飢[う]え死[じ]に","r":"うえじに","l":"飢え死に"},{"f":"する","r":"する","l":"する"},{"f":"か","r":"か","l":"か"},{"f":"盗人[ぬすびと]","r":"ぬすびと","l":"盗人"},{"f":"に","r":"に","l":"に"},{"f":"なる","r":"なる","l":"なる"},{"f":"か","r":"か","l":"か"},{"f":"と","r":"と","l":"と"},{"f":"聞[き]かれて","r":"きかれて","l":"聞く","i":{"en":"passive / potential / respectful (〜れる) + te-form","zh":"被动／可能／尊敬（〜れる） ＋ て形"}},{"f":"も","r":"も","l":"も"},{"f":"、","p":1},{"f":"下人[げにん]","r":"げにん","l":"下人"},{"f":"は","r":"は","l":"は"},{"f":"迷[まよ]う","r":"まよう","l":"迷う"},{"f":"こと","r":"こと","l":"こと"},{"f":"なく","r":"なく","l":"なく"},{"f":"飢[う]え死[じ]に","r":"うえじに","l":"飢え死に"},{"f":"を","r":"を","l":"を"},{"f":"選[えら]んだ","r":"えらんだ","l":"選ぶ","i":{"en":"past","zh":"过去式"}},{"f":"に","r":"に","l":"に"},{"f":"違[ちが]いない","r":"ちがいない","l":"違いない"},{"f":"。","p":1}],"tr":{"en":"If anyone had asked him then whether he would starve or become a thief, he would surely have chosen to starve without a moment's doubt.","zh":"此刻若有人问他是饿死还是做贼，他一定会毫不犹豫地选择饿死。"},"say":"今なら、飢え死にするか盗人になるかと聞かれても、下人は迷うことなく飢え死にを選んだに違いない。","g":[{"id":"koto-naku","from":16,"to":18},{"id":"ni-chigainai","from":22,"to":23}],"b":[{"from":0,"to":1,"r":"cond","h":"cond:なら","g":{"en":"if it were now","zh":"如果是现在"}},{"from":3,"to":10,"r":"quote","h":"quote:と","g":{"en":"\"starve or become a thief?\"","zh":"“饿死还是做贼？”"}},{"from":11,"to":12,"r":"cond","g":{"en":"even if (he) were asked","zh":"就算被问到"}},{"from":14,"to":15,"r":"topic","h":"topic:は","g":{"en":"as for the servant","zh":"仆人"}},{"from":16,"to":18,"r":"adv","g":{"en":"without hesitating","zh":"毫不犹豫地"},"n":{"en":"〜ことなく \"without ~ing\" (written).","zh":"〜ことなく表示“不…”（书面）。"}},{"from":19,"to":20,"r":"obj","h":"obj:を","g":{"en":"starving","zh":"饿死"}},{"from":21,"to":23,"r":"pred","h":"pred","g":{"en":"would surely have chosen","zh":"一定会选择"}}]},{"id":"rashomon/2/18","t":[{"f":"さっき","r":"さっき","l":"さっき"},{"f":"まで","r":"まで","l":"まで"},{"f":"自分[じぶん]","r":"じぶん","l":"自分"},{"f":"が","r":"が","l":"が"},{"f":"盗人[ぬすびと]","r":"ぬすびと","l":"盗人"},{"f":"に","r":"に","l":"に"},{"f":"なろう","r":"なろう","l":"なる","i":{"en":"volitional: let’s / I’ll","zh":"意志形：…吧"}},{"f":"と","r":"と","l":"と"},{"f":"していた","r":"していた","l":"する","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"こと","r":"こと","l":"こと"},{"f":"など","r":"など","l":"など"},{"f":"、","p":1},{"f":"すっかり","r":"すっかり","l":"すっかり"},{"f":"忘[わす]れていた","r":"わすれていた","l":"忘れる","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"の","r":"の","l":"の:nmz"},{"f":"で","r":"で","l":"で"},{"f":"ある","r":"ある","l":"ある"},{"f":"。","p":1}],"tr":{"en":"He had completely forgotten that only a moment ago he himself had been about to become a thief.","zh":"至于自己刚才还打算去做贼的事，他早已忘得一干二净。"},"say":"さっきまで自分が盗人になろうとしていたことなど、すっかり忘れていたのである。","g":[{"id":"you-to-suru","from":6,"to":8}],"b":[{"from":0,"to":1,"r":"until","h":"until:まで","g":{"en":"until a moment ago","zh":"直到刚才"}},{"from":2,"to":10,"r":"obj","g":{"en":"that he himself had been about to become a thief","zh":"自己还打算去当盗贼这件事"},"n":{"en":"こと turns the clause into a thing; など makes light of it: \"such a thing as his having been about to become a thief\".","zh":"こと把小句变成名词；など带有轻视语气：“自己曾想当盗贼这种事”。"}},{"from":12,"to":12,"r":"adv","g":{"en":"completely","zh":"完全"}},{"from":13,"to":16,"r":"pred","h":"pred","g":{"en":"had forgotten","zh":"忘了"}}]}],[{"id":"rashomon/2/19","t":[{"f":"下人[げにん]","r":"げにん","l":"下人"},{"f":"は","r":"は","l":"は"},{"f":"刀[かたな]","r":"かたな","l":"刀"},{"f":"に","r":"に","l":"に"},{"f":"手[て]","r":"て","l":"手"},{"f":"を","r":"を","l":"を"},{"f":"かける","r":"かける","l":"かける"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"いきなり","r":"いきなり","l":"いきなり"},{"f":"はしご","r":"はしご","l":"はしご"},{"f":"から","r":"から","l":"から"},{"f":"上[うえ]","r":"うえ","l":"上"},{"f":"へ","r":"へ","l":"へ"},{"f":"飛[と]び上[あ]がった","r":"とびあがった","l":"飛び上がる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"Gripping his sword, the servant suddenly leapt up from the ladder.","zh":"仆人手握刀柄，猛地从梯子上跳了上去。"},"say":"下人は刀に手をかけると、いきなりはしごから上へ飛び上がった。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the servant","zh":"仆人"}},{"from":2,"to":3,"r":"goal","h":"goal:に","g":{"en":"on his sword","zh":"往刀上"}},{"from":4,"to":7,"r":"verb","g":{"en":"put his hand, and (then)","zh":"一握"}},{"from":9,"to":9,"r":"adv","g":{"en":"suddenly","zh":"突然"}},{"from":10,"to":11,"r":"from","h":"from:から","g":{"en":"from the ladder","zh":"从梯子上"}},{"from":12,"to":13,"r":"goal","h":"goal:へ","g":{"en":"up","zh":"往上"}},{"from":14,"to":14,"r":"pred","h":"pred","g":{"en":"leapt","zh":"跳了上去"}}]},{"id":"rashomon/2/20","t":[{"f":"老婆[ろうば]","r":"ろうば","l":"老婆"},{"f":"は","r":"は","l":"は"},{"f":"ひどく","r":"ひどく","l":"ひどく"},{"f":"驚[おどろ]いて","r":"おどろいて","l":"驚く","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"ばね","r":"ばね","l":"ばね"},{"f":"で","r":"で","l":"で"},{"f":"はじかれた","r":"はじかれた","l":"はじく","i":{"en":"passive / potential / respectful (〜れる) + past","zh":"被动／可能／尊敬（〜れる） ＋ 过去式"}},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"飛[と]びのいた","r":"とびのいた","l":"飛びのく","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"The old woman, badly startled, sprang back as if thrown by a spring.","zh":"老太婆大吃一惊，像被弹簧弹开似的跳到一边。"},"say":"老婆はひどく驚いて、ばねではじかれたように飛びのいた。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the old woman","zh":"老太婆"}},{"from":2,"to":2,"r":"adv","g":{"en":"terribly","zh":"非常"}},{"from":3,"to":3,"r":"verb","g":{"en":"was startled, and","zh":"吃惊"}},{"from":5,"to":9,"r":"adv","g":{"en":"as if flung by a spring","zh":"像被弹簧弹开一样"},"n":{"en":"Passive はじかれる \"be flicked, be flung\"; で marks what flings it (the spring).","zh":"被动形はじかれる“被弹开”，で表示施加的工具（弹簧）。"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"sprang back","zh":"跳到一边"}}]},{"id":"rashomon/2/21","t":[{"f":"慌[あわ]てて","r":"あわてて","l":"慌てる","i":{"en":"te-form","zh":"て形"}},{"f":"逃[に]げよう","r":"にげよう","l":"逃げる","i":{"en":"volitional: let’s / I’ll","zh":"意志形：…吧"}},{"f":"と","r":"と","l":"と"},{"f":"する","r":"する","l":"する"},{"f":"ところ","r":"ところ","l":"ところ"},{"f":"を","r":"を","l":"を"},{"f":"、","p":1},{"f":"下人[げにん]","r":"げにん","l":"下人"},{"f":"は","r":"は","l":"は"},{"f":"行[ゆ]く手[て]","r":"ゆくて","l":"行く手"},{"f":"を","r":"を","l":"を"},{"f":"ふさいで","r":"ふさいで","l":"ふさぐ","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"その","r":"その","l":"その"},{"f":"腕[うで]","r":"うで","l":"腕"},{"f":"を","r":"を","l":"を"},{"f":"つかんだ","r":"つかんだ","l":"つかむ","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"Just as she tried to flee in a panic, the servant blocked her way and seized her arm.","zh":"就在她慌忙要逃的时候，仆人挡住她的去路，一把抓住了她的胳膊。"},"say":"慌てて逃げようとするところを、下人は行く手をふさいで、その腕をつかんだ。","g":[{"id":"tokoro-wo","from":4,"to":5}],"n":[{"from":4,"to":5,"body":{"en":"〜ところを \"at the very moment of ~\" is followed by an action that interrupts, stops or catches it, such as 捕まえる, 見つかる or 助ける.","zh":"〜ところを表示“正当…的时候”，后面接打断、阻止或抓住这一动作的行为，如捕まえる、見つかる、助ける。"}},{"from":9,"to":11,"body":{"en":"行く手 \"the way ahead\"; 行く手をふさぐ \"to block someone's way\".","zh":"行く手指“前方的去路”；行く手をふさぐ即“挡住去路”。"}}],"b":[{"from":0,"to":0,"r":"adv","g":{"en":"in a panic","zh":"慌慌张张地"}},{"from":1,"to":5,"r":"obj","h":"obj:を","g":{"en":"just as she tried to flee","zh":"正要逃跑时"},"n":{"en":"〜ところを \"at the very moment of ~\", acted on by the main verb: he caught her just as she tried to run.","zh":"〜ところを表示“正当…的时候”，主句动词作用于这一刻：正要逃跑时被他抓住。"}},{"from":7,"to":8,"r":"topic","h":"topic:は","g":{"en":"as for the servant","zh":"仆人"}},{"from":9,"to":10,"r":"obj","h":"obj:を","g":{"en":"her way","zh":"去路"}},{"from":11,"to":11,"r":"verb","g":{"en":"blocked, and","zh":"挡住"}},{"from":13,"to":15,"r":"obj","h":"obj:を","g":{"en":"her arm","zh":"她的胳膊"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"seized","zh":"抓住了"}}]},{"id":"rashomon/2/22","t":[{"f":"鶏[にわとり]","r":"にわとり","l":"鶏"},{"f":"の","r":"の","l":"の"},{"f":"足[あし]","r":"あし","l":"足"},{"f":"の","r":"の","l":"の"},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"、","p":1},{"f":"骨[ほね]","r":"ほね","l":"骨"},{"f":"と","r":"と","l":"と"},{"f":"皮[かわ]","r":"かわ","l":"皮"},{"f":"ばかり","r":"ばかり","l":"ばかり"},{"f":"の","r":"の","l":"の"},{"f":"腕[うで]","r":"うで","l":"腕"},{"f":"だった","r":"だった","l":"だ","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"It was an arm of nothing but skin and bone, like a chicken's leg.","zh":"那条胳膊像鸡爪一样，只剩皮包骨头。"},"say":"鶏の足のように、骨と皮ばかりの腕だった。","b":[{"from":0,"to":5,"r":"adv","g":{"en":"like a chicken's leg","zh":"像鸡爪一样"}},{"from":7,"to":11,"r":"mod","h":"mod:の","g":{"en":"nothing but skin and bone","zh":"皮包骨头的"},"n":{"en":"N＋ばかり \"nothing but N\": 骨と皮ばかり \"nothing but skin and bone\".","zh":"名词＋ばかり表示“全是…”：骨と皮ばかり“皮包骨头”。"}},{"from":12,"to":13,"r":"pred","h":"pred","g":{"en":"was an arm","zh":"胳膊"}}]},{"id":"rashomon/2/23","t":[{"f":"「","p":1},{"f":"おい","r":"おい","l":"おい"},{"f":"、","p":1},{"f":"何[なに]","r":"なに","l":"何"},{"f":"を","r":"を","l":"を"},{"f":"していた","r":"していた","l":"する","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"\"You there, what were you doing?","zh":"“喂，你在干什么？"},"say":"「おい、何をしていた。","who":"genin","b":[{"from":1,"to":1,"r":"call","g":{"en":"hey","zh":"喂"}},{"from":3,"to":4,"r":"obj","h":"obj:を","g":{"en":"what","zh":"什么"}},{"from":5,"to":5,"r":"pred","h":"pred","g":{"en":"were (you) doing?","zh":"你在干什么？"}}]},{"id":"rashomon/2/24","t":[{"f":"言[い]わない","r":"いわない","l":"言う","i":{"en":"negative","zh":"否定"}},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"これ","r":"これ","l":"これ"},{"f":"だ","r":"だ","l":"だ"},{"f":"ぞ","r":"ぞ","l":"ぞ"},{"f":"」","p":1}],"tr":{"en":"Tell me, or you'll get this.\"","zh":"不说的话，就让你尝尝这个。”"},"say":"言わないと、これだぞ」","who":"genin","b":[{"from":0,"to":1,"r":"cond","h":"cond:と","g":{"en":"if (you) don't tell","zh":"不说的话"}},{"from":3,"to":5,"r":"pred","h":"pred","g":{"en":"it's this","zh":"就是这个"},"n":{"en":"これだぞ \"it's this (for you)\": he is pointing at his sword. The threat is left unsaid.","zh":"これだぞ“就让你尝尝这个”，他指着刀，威胁的话没有明说。"}}]},{"id":"rashomon/2/25","t":[{"f":"下人[げにん]","r":"げにん","l":"下人"},{"f":"は","r":"は","l":"は"},{"f":"刀[かたな]","r":"かたな","l":"刀"},{"f":"を","r":"を","l":"を"},{"f":"抜[ぬ]く","r":"ぬく","l":"抜く"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"白[しろ]い","r":"しろい","l":"白い"},{"f":"刃[は]","r":"は","l":"刃"},{"f":"を","r":"を","l":"を"},{"f":"老婆[ろうば]","r":"ろうば","l":"老婆"},{"f":"の","r":"の","l":"の"},{"f":"目[め]","r":"め","l":"目"},{"f":"の","r":"の","l":"の"},{"f":"前[まえ]","r":"まえ","l":"前"},{"f":"に","r":"に","l":"に"},{"f":"突[つ]きつけた","r":"つきつけた","l":"突きつける","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"The servant drew his sword and thrust the white blade right in front of her eyes.","zh":"仆人拔出刀，把雪白的刀刃逼到老太婆眼前。"},"say":"下人は刀を抜くと、白い刃を老婆の目の前に突きつけた。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the servant","zh":"仆人"}},{"from":2,"to":5,"r":"verb","g":{"en":"drew his sword, and (then)","zh":"一拔出刀"}},{"from":7,"to":9,"r":"obj","h":"obj:を","g":{"en":"the white blade","zh":"雪白的刀刃"}},{"from":10,"to":15,"r":"goal","h":"goal:に","g":{"en":"right before the old woman's eyes","zh":"逼到老太婆眼前"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"thrust","zh":"逼了过去"}}]}]],"newGrammar":["ni-soui-nai","gatai","koto-naku","tokoro-wo"],"newVocab":["中ほど","縮める","殺す","ともす","相違ない","はい上がる","伸ばす","恐る恐る","いくつか","あちこち","投げ出す","まるで","土","人形","におい","思わず","おおう","老婆","うずくまる","背","低い","白髪頭","猿","右手","木切れ","親","子","しらみ","抜ける","恐ろしい","わく","対する","あらゆる","悪","はげしい","憎しみ","許す","思える","いきなり","飛び上がる","ばね","はじく","飛びのく","慌てる","行く手","ふさぐ","つかむ","鶏","骨","皮","刃","突きつける"],"chars":713,"h":"b0f157022c"}