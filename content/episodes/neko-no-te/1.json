"}},{"from":3,"to":4,"r":"subj","h":"subj:が","g":{"en":"the door","zh":"门"}},{"from":5,"to":5,"r":"verb","g":{"en":"opened, and","zh":"开了"}},{"from":7,"to":12,"r":"mod","h":"mod","g":{"en":"with a big camera hanging from his neck","zh":"脖子上挂着大相机的"},"n":{"en":"The clause describes 男: \"a man (who had) hung a big camera from his neck\".","zh":"这个小句修饰男：“脖子上挂着大相机的男人”。"}},{"from":13,"to":15,"r":"subj","h":"subj:が","g":{"en":"a young man","zh":"一个年轻男人"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"came in","zh":"走了进来"}}]},{"id":"neko-no-te/1/15","t":[{"f":"男[おとこ]","r":"おとこ","l":"男"},{"f":"は","r":"は","l":"は"},{"f":"ラーメン","r":"ラーメン","l":"ラーメン"},{"f":"を","r":"を","l":"を"},{"f":"一口[ひとくち]","r":"ひとくち","l":"一口"},{"f":"食[た]べる","r":"たべる","l":"食べる"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"目[め]","r":"め","l":"目"},{"f":"を","r":"を","l":"を"},{"f":"丸[まる]くした","r":"まるくした","l":"丸い","i":{"en":"〜くする (make ~) + past","zh":"〜くする（使…）＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"He took one mouthful of ramen, and his eyes went wide.","zh":"他吃了一口拉面，眼睛一下子瞪得圆圆的。"},"say":"男はラーメンを一口食べると、目を丸くした。","n":[{"from":8,"to":10,"body":{"en":"目を丸くする \"make your eyes round\" means to be amazed.","zh":"目を丸くする字面是“把眼睛瞪圆”，表示吃惊。"}}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the man","zh":"那个男人"}},{"from":2,"to":6,"r":"cond","h":"cond:と","g":{"en":"when (he) ate a mouthful of ramen","zh":"吃了一口拉面"}},{"from":8,"to":9,"r":"obj","h":"obj:を","g":{"en":"(his) eyes","zh":"眼睛"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"made round","zh":"瞪得圆圆的"},"n":{"en":"い-adjective＋くする \"make ~\": 目を丸くする \"make one's eyes round\", i.e. be amazed.","zh":"い形容词＋くする表示“使…”：目を丸くする“把眼睛瞪圆”，表示惊讶。"}}]},{"id":"neko-no-te/1/16","t":[{"f":"それ","r":"それ","l":"それ"},{"f":"から","r":"から","l":"から"},{"f":"何枚[なんまい]","r":"なんまい","l":"何枚"},{"f":"も","r":"も","l":"も"},{"f":"写真[しゃしん]","r":"しゃしん","l":"写真"},{"f":"を","r":"を","l":"を"},{"f":"撮[と]り","r":"とり","l":"撮る","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":