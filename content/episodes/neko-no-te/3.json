o":8,"r":"cond","h":"cond:と","g":{"en":"when Gen was washing bowls at the back","zh":"阿源在里面洗碗的时候"}},{"from":10,"to":11,"r":"subj","h":"subj:が","g":{"en":"Tora","zh":"阿虎"}},{"from":12,"to":13,"r":"goal","h":"goal:に","g":{"en":"into the kitchen","zh":"往厨房"}},{"from":14,"to":14,"r":"verb","g":{"en":"came running, and","zh":"跑了进来"}},{"from":16,"to":18,"r":"means","h":"means:で","g":{"en":"in a loud voice","zh":"大声地"}},{"from":19,"to":19,"r":"pred","h":"pred","g":{"en":"started meowing","zh":"叫了起来"}}]},{"id":"neko-no-te/3/11","t":[{"f":"振[ふ]り向[む]く","r":"ふりむく","l":"振り向く"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"スープ","r":"スープ","l":"スープ"},{"f":"の","r":"の","l":"の"},{"f":"鍋[なべ]","r":"なべ","l":"鍋"},{"f":"から","r":"から","l":"から"},{"f":"白[しろ]い","r":"しろい","l":"白い"},{"f":"煙[けむり]","r":"けむり","l":"煙"},{"f":"が","r":"が","l":"が"},{"f":"上[あ]がっていた","r":"あがっていた","l":"上がる","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"He turned round to see white smoke rising from the pot of soup.","zh":"他回头一看，汤锅里正冒着白烟。"},"say":"振り向くと、スープの鍋から白い煙が上がっていた。","b":[{"from":0,"to":1,"r":"cond","h":"cond:と","g":{"en":"when (he) turned round","zh":"一回头"}},{"from":3,"to":6,"r":"from","h":"from:から","g":{"en":"from the soup pot","zh":"从汤锅里"}},{"from":7,"to":9,"r":"subj","h":"subj:が","g":{"en":"white smoke","zh":"白烟"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"was rising","zh":"正冒着"}}]},{"id":"neko-no-te/3/12","t":[{"f":"源[げん]","r":"げん","l":"源"},{"f":"さん","r":"さん","l":"さん"},{"f":"は","r":"は","l":"は"},{"f":"あわてて","r":"あわてて","l":"あわてる","i":{"en":"te-form","zh":"て形"}},{"f":"火[ひ]","r":"ひ","l":"火"},{"f":"を","r":"を","l":"を"},{"f":"止[と]めた","r":"とめた","l":"止める","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"Gen hurriedly turned off the heat.","zh":"阿源慌忙关了火。"},"say":"げんさんはあわてて火を止めた。","b":[{"from":0,"to":2,"r":"topic","h":"topic:は","g":{"en":"as for Gen","zh":"阿源"}},{"from":3,"to":3,"r":"adv","g":{"en":"in a hurry","zh":"慌忙"}},{"from":4,"to":5,"r":"obj","h":"obj:を","g":{"en":"the heat","zh":"火"}},{"from":6,"to":6,"r":"pred","h":"pred","g":{"en":"turned off","zh":"关掉了"}}]},{"id":"neko-no-te/3/13","t":[{"f":"もう","r":"もう","l":"もう"},{"f":"少[すこ]し","r":"すこし","l":"少し"},{"f":"で","r":"で","l":"で"},{"f":"、","p":1},{"f":"三十[さんじゅう]","r":"さんじゅう","l":"三十"},{"f":"年[ねん]","r":"ねん","l":"年:ねん"},{"f":"守[まも]ってきた","r":"まもってきた","l":"守る","i":{"en":"〜てくる: comes ~ing / has been ~ing + past","zh":"〜てくる：…起来／…过来 ＋ 过去式"}},{"f":"スープ","r":"スープ","l":"スープ"},{"f":"が","r":"が","l":"が"},{"f":"焦[こ]げる","r":"こげる","l":"焦げる"},{"f":"ところ","r":"ところ","l":"ところ"},{"f":"だった","r":"だった","l":"だ","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"A little longer, and the soup he had looked after for thirty years would have burned.","zh":"差一点儿，他守了三十年的汤就要烧焦了。"},"say":"もう少しで、三十年守ってきたスープが焦げるところだった。","g":[{"id":"tokoro-datta","from":9,"to":11}],"n":[{"from":0,"to":2,"body":{"en":"もう少しで (\"a little more and ...\") often comes with 〜ところだった, \"almost ~\".","zh":"もう少しで（“再差一点就…”）常和〜ところだった一起用，表示“差点儿…”。"}},{"from":6,"to":6,"body":{"en":"守る is \"to protect, keep\". 〜てきた adds \"all this time, up to now\". A ramen shop's soup is its pride, often made the same way for decades.","zh":"守る是“守护、保持”，〜てきた表示“一直以来”。对拉面店来说，汤头是招牌，常常几十年用同样的方法熬制。"}}],"b":[{"from":0,"to":2,"r":"cond","g":{"en":"a little more, and","zh":"再晚一点"}},{"from":4,"to":6,"r":"mod","h":"mod","g":{"en":"that (he) had kept for thirty years","zh":"守护了三十年的"}},{"from":7,"to":8,"r":"subj","h":"subj:が","g":{"en":"the soup","zh":"汤"}},{"from":9,"to":11,"r":"pred","h":"pred","g":{"en":"was about to burn","zh":"差点就糊了"},"n":{"en":"V-dictionary＋ところだった \"was about to ~ (but didn't)\". With もう少しで: \"nearly ~\".","zh":"动词原形＋ところだった表示“差点就…（但没有）”。与もう少しで连用，“差一点就…”。"}}]},{"id":"neko-no-te/3/14","t":[{"f":"「","p":1},{"f":"寝[ね]て","r":"ねて","l":"寝る","i":{"en":"te-form","zh":"て形"}},{"f":"ばかり","r":"ばかり","l":"ばかり"},{"f":"いる","r":"いる","l":"いる"},{"f":"と","r":"と","l":"と"},{"f":"思[おも]ってた","r":"おもってた","l":"思う","i":{"en":"〜てる: = 〜ている (casual) + past","zh":"〜てる：＝〜ている（口语） ＋ 过去式"}},{"f":"けど","r":"けど","l":"けど"},{"f":"、","p":1},{"f":"おまえ","r":"おまえ","l":"おまえ"},{"f":"の","r":"の","l":"の"},{"f":"おかげ","r":"おかげ","l":"おかげ"},{"f":"で","r":"で","l":"で"},{"f":"助[たす]かった","r":"たすかった","l":"助かる","i":{"en":"past","zh":"过去式"}},{"f":"よ","r":"よ","l":"よ"},{"f":"」","p":1}],"tr":{"en":"\"I thought all you ever did was sleep, but you've saved my skin.\"","zh":"“我还以为你只会睡觉，多亏了你，真是帮了大忙。”"},"say":"「寝てばかりいると思ってたけど、おまえのおかげで助かったよ」","g":[{"id":"bakari-iru","from":1,"to":3},{"id":"okage-de","from":9,"to":11}],"who":"gen","b":[{"from":1,"to":6,"r":"verb","h":"verb:けど","g":{"en":"(I) thought (you) did nothing but sleep, but","zh":"我还以为你光会睡觉"},"n":{"en":"〜と思ってた \"I thought ~ (but I was wrong)\": the past tense hints that he has changed his mind.","zh":"〜と思ってた“我原以为…”：过去时暗示他改变了看法。"}},{"from":8,"to":11,"r":"reason","h":"reason:で","g":{"en":"thanks to you","zh":"多亏了你"}},{"from":12,"to":13,"r":"pred","h":"pred","g":{"en":"(I) was saved","zh":"帮了大忙了"}}]}],[{"id":"neko-no-te/3/15","t":[{"f":"しかし","r":"しかし","l":"しかし"},{"f":"、","p":1},{"f":"その","r":"その","l":"その"},{"f":"せい","r":"せい","l":"せい"},{"f":"で","r":"で","l":"で"},{"f":"、","p":1},{"f":"スープ","r":"スープ","l":"スープ"},{"f":"は","r":"は","l":"は"},{"f":"少[すこ]し","r":"すこし","l":"少し"},{"f":"しか","r":"しか","l":"しか"},{"f":"残[のこ]らなかった","r":"のこらなかった","l":"残る","i":{"en":"negative past","zh":"否定过去式"}},{"f":"。","p":1}],"tr":{"en":"Because of all that, though, there was only a little soup left.","zh":"不过，因为这件事，汤只剩下了一点点。"},"say":"しかし、そのせいで、スープは少ししか残らなかった。","g":[{"id":"sei-de","from":2,"to":4},{"id":"shika-nai","from":9,"to":10}],"b":[{"from":0,"to":0,"r":"conn","g":{"en":"but","zh":"但是"}},{"from":2,"to":4,"r":"reason","h":"reason:で","g":{"en":"because of that","zh":"因为这个"}},{"from":6,"to":7,"r":"topic","h":"topic:は","g":{"en":"as for the soup","zh":"汤"}},{"from":8,"to":9,"r":"amount","h":"amount","g":{"en":"only a little","zh":"只"},"n":{"en":"〜しか〜ない \"only ~\": 少ししか残らない \"only a little is left\".","zh":"〜しか〜ない表示“只有…”：少ししか残らない“只剩下一点点”。"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"was left","zh":"剩下了一点点"}}]},{"id":"neko-no-te/3/16","t":[{"f":"「","p":1},{"f":"すみません","r":"すみません","l":"すみません"},{"f":"、","p":1},{"f":"今日[きょう]","r":"きょう","l":"今日"},{"f":"は","r":"は","l":"は"},{"f":"これ","r":"これ","l":"これ"},{"f":"で","r":"で","l":"で"},{"f":"終[お]わり","r":"おわり","l":"終わり"},{"f":"です","r":"です","l":"です"},{"f":"」","p":1}],"tr":{"en":"\"Sorry, that's all for today.\"","zh":"“不好意思，今天就到此为止了。”"},"say":"「すみません、今日はこれで終わりです」","who":"gen","b":[{"from":1,"to":1,"r":"call","g":{"en":"sorry","zh":"对不起"}},{"from":3,"to":4,"r":"topic","h":"topic:は","g":{"en":"as for today","zh":"今天"}},{"from":5,"to":6,"r":"time","h":"time","g":{"en":"with this","zh":"到此"}},{"from":7,"to":8,"r":"pred","h":"pred","g":{"en":"it's the end","zh":"就结束了"}}]},{"id":"neko-no-te/3/17","t":[{"f":"「","p":1},{"f":"せっかく","r":"せっかく","l":"せっかく"},{"f":"二時間[にじかん]","r":"にじかん","l":"二時間"},{"f":"も","r":"も","l":"も"},{"f":"並[なら]んだ","r":"ならんだ","l":"並ぶ","i":{"en":"past","zh":"过去式"}},{"f":"のに","r":"のに","l":"のに"},{"f":"！","p":1},{"f":"」","p":1}],"tr":{"en":"\"But I queued for two whole hours!\"","zh":"“我好不容易排了两个小时啊！”"},"say":"「せっかく二時間も並んだのに！」","g":[{"id":"noni","from":4,"to":5}],"n":[{"from":1,"to":5,"body":{"en":"のに \"even though\" carries disappointment or complaint. せっかく (\"after all the trouble\") makes it stronger. Ending a sentence with のに leaves the complaint hanging.","zh":"のに表示“明明…却…”，带有失望、不满的情绪。せっかく（“好不容易”）加强了这种语气。把のに放在句末，后半句的抱怨就不言而喻了。"}}],"who":"kyaku","b":[{"from":1,"to":1,"r":"adv","g":{"en":"after all that trouble","zh":"好不容易"}},{"from":2,"to":3,"r":"amount","h":"amount","g":{"en":"as much as two hours","zh":"足足两个小时"}},{"from":4,"to":5,"r":"pred","h":"pred","g":{"en":"and yet (I) queued","zh":"排了队，结果…"},"n":{"en":"A sentence ending in のに shows disappointment: \"even though I queued (and now this!)\". せっかく \"after going to all that trouble\".","zh":"以のに结尾的句子表示失望：“明明排了队（却这样！）”。せっかく表示“好不容易”。"}}]},{"id":"neko-no-te/3/18","t":[{"f":"帰[かえ]っていく","r":"かえっていく","l":"帰る","i":{"en":"〜ていく: goes on ~ing / away from now","zh":"〜ていく：…下去"}},{"f":"客[きゃく]","r":"きゃく","l":"客"},{"f":"たち","r":"たち","l":"たち"},{"f":"の","r":"の","l":"の"},{"f":"中[なか]","r":"なか","l":"中"},{"f":"で","r":"で","l":"で"},{"f":"、","p":1},{"f":"一人[ひとり]","r":"ひとり","l":"一人"},{"f":"だけ","r":"だけ","l":"だけ"},{"f":"動[うご]かない","r":"うごかない","l":"動く","i":{"en":"negative","zh":"否定"}},{"f":"女[おんな]の子[こ]","r":"おんなのこ","l":"女の子"},{"f":"が","r":"が","l":"が"},{"f":"いた","r":"いた","l":"いる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"Among the customers heading home, there was one girl who didn't move.","zh":"在纷纷离开的客人中，只有一个女孩子站着没动。"},"say":"帰っていく客たちの中で、一人だけ動かない女の子がいた。","b":[{"from":0,"to":0,"r":"mod","h":"mod","g":{"en":"going home","zh":"陆续回去的"}},{"from":1,"to":5,"r":"place","h":"place:で","g":{"en":"among the customers","zh":"客人们当中"}},{"from":7,"to":9,"r":"mod","h":"mod","g":{"en":"who alone didn't move","zh":"唯独一动不动的"}},{"from":10,"to":11,"r":"subj","h":"subj:が","g":{"en":"a girl","zh":"一个女孩"}},{"from":12,"to":12,"r":"pred","h":"pred","g":{"en":"there was","zh":"有"}}]}]],"newGrammar":["ppoi","tokoro-datta"],"newVocab":["抱き上げる","するりと","腕","抜け出す","ちょこんと","やめる","列","見張る","いつのまにか","やってくる","奥","振り向く","スープ","鍋","あわてる","守る","焦げる","しかし","残る","終わり","せっかく","二時間"],"chars":360,"h":"8cdc55aafa"}