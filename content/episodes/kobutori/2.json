":"啪地一下"}},{"from":14,"to":14,"r":"pred","h":"pred","g":{"en":"took off","zh":"取了下来"}}]},{"id":"kobutori/2/8","t":[{"f":"少[すこ]し","r":"すこし","l":"少し"},{"f":"も","r":"も","l":"も"},{"f":"いたく","r":"いたく","l":"いたい","i":{"en":"〜く: adverbial / continuing","zh":"〜く：副词用法／中顿"}},{"f":"なかった","r":"なかった","l":"ない","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"It didn't hurt one bit.","zh":"一点也不疼。"},"say":"少しもいたくなかった。","g":[{"id":"adj-negative","from":2,"to":3}],"b":[{"from":0,"to":1,"r":"adv","g":{"en":"not even a little","zh":"一点也"},"n":{"en":"少しも + negative \"not at all, not a bit\".","zh":"少しも＋否定：“一点也不…”。"}},{"from":2,"to":3,"r":"pred","h":"pred","g":{"en":"didn't hurt","zh":"不疼"}}]}],[{"id":"kobutori/2/9","t":[{"f":"鬼[おに]","r":"おに","l":"鬼"},{"f":"に","r":"に","l":"に"},{"f":"こぶ","r":"こぶ","l":"こぶ"},{"f":"を","r":"を","l":"を"},{"f":"取[と]られて","r":"とられて","l":"取る","i":{"en":"passive (〜られる) + te-form","zh":"被动态（〜られる）＋て形"}},{"f":"、","p":1},{"f":"おじいさん","r":"おじいさん","l":"おじいさん"},{"f":"は","r":"は","l":"は"},{"f":"とても","r":"とても","l":"とても"},{"f":"よろこんだ","r":"よろこんだ","l":"よろこぶ","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"With his lump taken by the ogres, the old man was overjoyed.","zh":"瘤子被鬼摘走了，老爷爷高兴极了。"},"say":"鬼にこぶを取られて、おじいさんはとてもよろこんだ。","g":[{"id":"passive","from":4,"to":4}],"b":[{"from":0,"to":1,"r":"agent","h":"agent:に","g":{"en":"by the ogre","zh":"被鬼"}},{"from":2,"to":3,"r":"obj","h":"obj:を","g":{"en":"the lump","zh":"肉瘤"}},{"from":4,"to":4,"r":"verb","g":{"en":"having (it) taken,","zh":"取走了"},"n":{"en":"Passive: 取られる \"have (something) taken\". に marks who did it.","zh":"被动：取られる“被取走”。に表示施动者。"}},{"from":6,"to":7,"r":"topic","h":"topic:は","g":{"en":"as for the old man","zh":"老爷爷"}},{"from":8,"to":8,"r":"adv","g":{"en":"very","zh":"非常"}},{"from":9,"to":9,"r":"pred","h":"pred","g":{"en":"was happy","zh":"高兴"}}]},{"id":"kobutori/2/10","t":[{"f":"村[むら]","r":"むら","l":"村"},{"f":"に","r":"に","l":"に"},{"f":"帰[かえ]る","r":"かえる","l":"帰る"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p