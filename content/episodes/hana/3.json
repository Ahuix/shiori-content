]","r":"した","l":"下"},{"f":"まで","r":"まで","l":"まで"},{"f":"、","p":1},{"f":"ぶらりと","r":"ぶらりと","l":"ぶらりと"},{"f":"垂[た]れていた","r":"たれていた","l":"垂れる","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"And Naigu's nose was hanging down once more, from above his upper lip to below his chin.","zh":"而内供的鼻子，又从上唇上方一直垂到了下巴下面。"},"say":"そしてないぐの鼻は、また上唇の上からあごの下まで、ぶらりと垂れていた。","b":[{"from":0,"to":0,"r":"conn","g":{"en":"and","zh":"而且"}},{"from":1,"to":4,"r":"topic","h":"topic:は","g":{"en":"as for Naigu's nose","zh":"内供的鼻子"}},{"from":6,"to":6,"r":"adv","g":{"en":"again","zh":"又"}},{"from":7,"to":10,"r":"from","h":"from:から","g":{"en":"from above the upper lip","zh":"从上唇上方"}},{"from":11,"to":14,"r":"until","h":"until:まで","g":{"en":"to below the chin","zh":"一直到下巴下面"}},{"from":16,"to":16,"r":"adv","g":{"en":"loosely","zh":"晃晃悠悠地"}},{"from":17,"to":17,"r":"pred","h":"pred","g":{"en":"was hanging","zh":"垂着"}}]},{"id":"hana/3/17","t":[{"f":"鼻[はな]","r":"はな","l":"鼻"},{"f":"が","r":"が","l":"が"},{"f":"一晩[ひとばん]","r":"ひとばん","l":"一晩"},{"f":"で","r":"で","l":"で"},{"f":"元[もと]","r":"もと","l":"元"},{"f":"に","r":"に","l":"に"},{"f":"戻[もど]った","r":"もどった","l":"戻る","i":{"en":"past","zh":"过去式"}},{"f":"と","r":"と","l":"と"},{"f":"知[し]る","r":"しる","l":"知る"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"内供[ないぐ]","r":"ないぐ","l":"内供"},{"f":"は","r":"は","l":"は"},{"f":"なぜか","r":"なぜか","l":"なぜ","i":{"en":"か","zh":"か"}},{"f":"ほっと","r":"ほっと","l":"ほっと"},{"f":"した","r":"した","l":"する","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"When he realised that his nose had gone back to how it was in a single night, Naigu felt, for some reason, relieved.","zh":"知道鼻子一夜之间恢复了原样，内供不知为何松了一口气。"},"say":"鼻が一晩で元に戻ったと知ると、ないぐはなぜかほっとした。","b":[{"from":0,"to":9,"r":"cond","h":"cond:と","g":{"en":"when (he) learned the nose had gone back in one night","zh":"得知鼻子一夜之间恢复原样"},"n":{"en":"元に戻る \"go back to how it was\".","zh":"元に戻る表示“恢复原样”。"}},{"from":11,"to":12,"r":"topic","h":"topic:は"