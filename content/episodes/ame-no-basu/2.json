","l":"は"},{"f":"かばん","r":"かばん","l":"かばん"},{"f":"の","r":"の","l":"の"},{"f":"中[なか]","r":"なか","l":"中"},{"f":"で","r":"で","l":"で"},{"f":"待[ま]っていました","r":"まっていました","l":"待つ","i":{"en":"〜ている: ongoing action or resulting state + polite past","zh":"〜ている：动作进行／状态持续 ＋ 礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"The picture waited in his school bag.","zh":"那幅画一直在书包里等着。"},"say":"絵はかばんの中で待っていました。","g":[{"id":"te-iru","from":6,"to":6}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the picture","zh":"画"}},{"from":2,"to":5,"r":"place","h":"place:で","g":{"en":"inside the bag","zh":"在书包里"}},{"from":6,"to":6,"r":"pred","h":"pred","g":{"en":"was waiting","zh":"一直等着"}}]}]],"newGrammar":[],"newVocab":["奥さん","先月","会う","妻","花","好き","終わる","部屋","絵","描く","黄色い","きれい","友だち","かばん","待つ"],"chars":255,"h":"0e184ded36"}