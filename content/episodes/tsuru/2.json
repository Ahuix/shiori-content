入[はい]る","r":"はいる","l":"入る"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"戸[と]","r":"と","l":"戸"},{"f":"を","r":"を","l":"を"},{"f":"ぴったり","r":"ぴったり","l":"ぴったり"},{"f":"と","r":"と","l":"と"},{"f":"閉[し]めました","r":"しめました","l":"閉める","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"Tsū went into the back room and shut the door tight.","zh":"阿通走进里屋，把门关得严严实实。"},"say":"つうは奥の部屋に入ると、戸をぴったりと閉めました。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tsū","zh":"阿通"}},{"from":2,"to":7,"r":"verb","g":{"en":"went into the back room, and (then)","zh":"一走进里屋"}},{"from":9,"to":10,"r":"obj","h":"obj:を","g":{"en":"the door","zh":"门"}},{"from":11,"to":12,"r":"adv","g":{"en":"tight","zh":"严严实实地"}},{"from":13,"to":13,"r":"pred","h":"pred","g":{"en":"shut","zh":"关上了"}}]},{"id":"tsuru/2/8","t":[{"f":"やがて","r":"やがて","l":"やがて"},{"f":"、","p":1},{"f":"「","p":1},{"f":"トンカラリ","r":"トンカラリ","l":"トンカラリ"},{"f":"、","p":1},{"f":"トンカラリ","r":"トンカラリ","l":"トンカラリ"},{"f":"」","p":1},{"f":"と","r":"と","l":"と"},{"f":"、","p":1},{"f":"機[はた]","r":"はた","l":"機"},{"f":"を","r":"を","l":"を"},{"f":"織[お]る","r":"おる","l":"織る"},{"f":"音[おと]","r":"おと","l":"音"},{"f":"が","r":"が","l":"が"},{"f":"聞[き]こえてきました","r":"きこえてきました","l":"聞こえる","i":{"en":"〜てくる: comes ~ing / has been ~ing + polite past","zh":"〜てくる：…起来／…过来 ＋ 礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"Before long, the clack and rattle of the loom could be heard.","zh":"不久，传来了“咔嗒咔嗒”的织布声。"},"say":"やがて、「トンカラリ、トンカラリ」と、機を織る音が聞こえてきました。","n":[{"from":3,"to":3,"body":{"en":"トンカラリ is the traditional sound of a hand loom in Japanese folk tales.","zh":"トンカラリ是日本民间故事中手工织布机的传统拟声词。"}}],"b":[{"from":0,"to":0,"r":"time","h":"time","g":{"en":"before long","zh":"不久"}},{"from":3,"to":11,"r":"mod","h":"mod","g":{"en":"of weaving at the loom, clack-rattle, clack-rattle","zh":"“咔嗒咔嗒”织布的"},"n":{"en":"The sound word with と is part of the description of 音: \"the sound of weaving, clack-rattle\".","zh":"带と的拟声词也是修饰音的一部分：“咔嗒咔嗒织布的声音”。"}},{"from":12,"to":13,"r":"subj","h":"subj:が"