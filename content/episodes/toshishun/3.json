":{"en":"is standing","zh":"站着"}}]},{"id":"toshishun/3/19","t":[{"f":"「","p":1},{"f":"どう","r":"どう","l":"どう"},{"f":"だ","r":"だ","l":"だ"},{"f":"。","p":1},{"f":"わし","r":"わし","l":"わし"},{"f":"の","r":"の","l":"の"},{"f":"弟子[でし]","r":"でし","l":"弟子"},{"f":"に","r":"に","l":"に"},{"f":"なって","r":"なって","l":"なる","i":{"en":"te-form","zh":"て形"}},{"f":"も","r":"も","l":"も"},{"f":"、","p":1},{"f":"とても","r":"とても","l":"とても"},{"f":"仙人[せんにん]","r":"せんにん","l":"仙人"},{"f":"に","r":"に","l":"に"},{"f":"は","r":"は","l":"は"},{"f":"なれまい","r":"なれまい","l":"なる","i":{"en":"potential + 〜まい: probably can't ~ (literary)","zh":"可能态 ＋ 〜まい：大概不能…（书面）"}},{"f":"」","p":1}],"tr":{"en":"\"Well? Even as my disciple, you could never become a sage.\"","zh":"“怎么样？就算做了我的弟子，你也成不了仙人吧。”"},"say":"「どうだ。わしの弟子になっても、とても仙人にはなれまい」","g":[{"id":"mai","from":15,"to":15}],"n":[{"from":15,"to":15,"body":{"en":"V + まい is a literary negative: \"will probably not ~\" (guess) or \"will not ~\" (resolve). なれまい = なれないだろう.","zh":"动词＋まい是书面的否定：表示推测“大概不会…”或决心“决不…”。なれまい＝なれないだろう。"}}],"who":"tekkanshi","b":[{"from":1,"to":2,"r":"call","g":{"en":"well?","zh":"怎么样？"}},{"from":4,"to":9,"r":"cond","g":{"en":"even if you became my disciple","zh":"就算当了我的弟子"}},{"from":11,"to":11,"r":"adv","g":{"en":"at all","zh":"无论如何"}},{"from":12,"to":15,"r":"pred","h":"pred","g":{"en":"you could never become a sage","zh":"你也成不了仙人吧"},"n":{"en":"〜まい \"probably not; will not\" (written). なれまい \"(you) surely can't become\".","zh":"〜まい表示“大概不会…”（书面）。なれまい“想必成不了”。"}}]},{"id":"toshishun/3/20","t":[{"f":"「","p":1},{"f":"なれません","r":"なれません","l":"なる","i":{"en":"potential negative, polite: can't ~","zh":"可能态否定（礼貌体）：不能…"}},{"f":"。","p":1},{"f":"なれません","r":"なれません","l":"なる","i":{"en":"potential negative, polite: can't ~","zh":"可能态否定（礼貌体）：不能…"}},{"f":"が","r":"が","l":"が:but"},{"f":"、","p":1},{"f":"なれなかった","r":"なれなかった","l":"なる","i":{"en":"potential negative past: couldn't ~","zh":"可能态否定过去式：没能…"}},{"f":"こと","r":"こと","l":"こと"},{"f":"を","r":"を","l":"を"},{"f":"、","p":1},{"f":"かえって","r":"かえって","l":"かえ