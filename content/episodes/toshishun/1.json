i":{"en":"〜ている: ongoing action or resulting state","zh":"〜ている：动作进行／状态持续"}},{"f":"の","r":"の","l":"の:nmz"},{"f":"です","r":"です","l":"です"},{"f":"」","p":1}],"tr":{"en":"\"I have nowhere to sleep tonight, and I'm wondering what to do.\"","zh":"“我今晚连睡觉的地方都没有，正在想该怎么办。”"},"say":"「今夜寝るところもないので、どうしようかと考えているのです」","who":"toshishun","b":[{"from":1,"to":6,"r":"reason","h":"reason:ので","g":{"en":"since (I) have nowhere to sleep tonight","zh":"因为今晚连睡觉的地方都没有"}},{"from":8,"to":11,"r":"quote","h":"quote:と","g":{"en":"\"what shall I do?\"","zh":"“该怎么办呢”"}},{"from":12,"to":14,"r":"pred","h":"pred","g":{"en":"(I) am thinking","zh":"我在想"}}]},{"id":"toshishun/1/8","t":[{"f":"老人[ろうじん]","r":"ろうじん","l":"老人"},{"f":"は","r":"は","l":"は"},{"f":"しばらく","r":"しばらく","l":"しばらく"},{"f":"黙[だま]っていた","r":"だまっていた","l":"黙る","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"が","r":"が","l":"が:but"},{"f":"、","p":1},{"f":"やがて","r":"やがて","l":"やがて"},{"f":"夕日[ゆうひ]","r":"ゆうひ","l":"夕日"},{"f":"の","r":"の","l":"の"},{"f":"中[なか]","r":"なか","l":"中"},{"f":"に","r":"に","l":"に"},{"f":"のびた","r":"のびた","l":"のびる","i":{"en":"past","zh":"过去式"}},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"の","r":"の","l":"の"},{"f":"影[かげ]","r":"かげ","l":"影"},{"f":"を","r":"を","l":"を"},{"f":"指[ゆび]さした","r":"ゆびさした","l":"指さす","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"The old man was silent for a while, then pointed at Tu Tze-chun's shadow stretching out in the evening sun.","zh":"老人沉默了一会儿，然后指着杜子春在夕阳中拉长的影子。"},"say":"老人はしばらく黙っていたが、やがて夕日の中にのびたとししゅんの影を指さした。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the old man","zh":"老人"}},{"from":2,"to":2,"r":"time","h":"time","g":{"en":"for a while","zh":"好一会儿"}},{"from":3,"to":4,"r":"verb","h":"verb:が","g":{"en":"was silent, but","zh":"沉默着，但是"}},{"from":6,"to":6,"r":"time","h":"time","g":{"en":"soon","zh":"不久"}},{"from":7,"to":11,"r":"mod","h":"mod","g":{"en":"stretching out in the evening sun","zh":"在夕阳中拉长的"}},{"from":12,"to":15,"r":"obj","h":"obj:を","g":{"en":"Tu Tze-chun's shadow","zh":"杜子春的影子"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"pointed at","zh":"指了指"}}]},{"id":"toshishun/1/9","t":[{"f":"「","p":1},{"f":"では","r":"では","l":"では"},{"f":"、","p":1},{"f":"いい","r":"いい","l":"いい"},{"f":"こと","r":"こと","l":"こと"},{"f":"を","r":"を","l":"を"},{"f":"教[おし]えてやろう","r":"おしえてやろう","l":"教える","i":{"en":"〜てやる: do for (an animal, child or someone below you) + volitional: let’s / I’ll","zh":"〜てやる：为（动物、孩子或晚辈）做 ＋ 意志形：…吧"}},{"f":"。","p":1},{"f":"この","r":"この","l":"この"},{"f":"影[かげ]","r":"かげ","l":"影"},{"f":"の","r":"の","l":"の"},{"f":"頭[あたま]","r":"あたま","l":"頭"},{"f":"の","r":"の","l":"の"},{"f":"ところ","r":"ところ","l":"ところ"},{"f":"を","r":"を","l":"を"},{"f":"、","p":1},{"f":"夜中[よなか]","r":"よなか","l":"夜中"},{"f":"に","r":"に","l":"に"},{"f":"掘[ほ]ってみる","r":"ほってみる","l":"掘る","i":{"en":"〜てみる: try ~ing","zh":"〜てみる：试着…"}},{"f":"が","r":"が","l":"が:but"},{"f":"いい","r":"いい","l":"いい"},{"f":"」","p":1}],"tr":{"en":"\"Then I'll tell you something good. Tonight, dig where the head of your shadow lies.\"","zh":"“那我就告诉你一件好事。半夜里，你在这影子的头部那里挖挖看吧。”"},"say":"「では、いいことを教えてやろう。この影の頭のところを、夜中に掘ってみるがいい」","n":[{"from":18,"to":20,"body":{"en":"〜がいい is an old-fashioned, rather lofty way of telling someone to do something, \"you'd do well to ~\".","zh":"〜がいい是带有居高临下语气的旧式说法，意思是“你不妨…吧”。"}}],"who":"tekkanshi","b":[{"from":1,"to":1,"r":"conn","g":{"en":"well then","zh":"那么"}},{"from":3,"to":5,"r":"obj","h":"obj:を","g":{"en":"a good thing","zh":"好事"}},{"from":6,"to":6,"r":"pred","h":"pred","g":{"en":"I'll tell you","zh":"我告诉你吧"}},{"from":8,"to":14,"r":"obj","h":"obj:を","g":{"en":"where the head of this shadow is","zh":"这影子头部所在的地方"}},{"from":16,"to":17,"r":"time","h":"time:に","g":{"en":"in the middle of the night","zh":"半夜里"}},{"from":18,"to":20,"r":"pred","h":"pred","g":{"en":"you'd do well to dig","zh":"你去挖挖看吧"},"n":{"en":"V＋がいい \"you'd do well to V\", an older, slightly lordly way of advising.","zh":"V＋がいい表示“…就好，不妨…”，是较旧、略带居高临下语气的建议。"}}]},{"id":"toshishun/1/10","t":[{"f":"言[い]われた","r":"いわれた","l":"言う","i":{"en":"passive / potential / respectful (〜れる) + past","zh":"被动／可能／尊敬（〜れる） ＋ 过去式"}},{"f":"とおり","r":"とおり","l":"とおり"},{"f":"に","r":"に","l":"に"},{"f":"掘[ほ]ってみる","r":"ほってみる","l":"掘る","i":{"en":"〜てみる: try ~ing","zh":"〜てみる：试着…"}},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"なんと","r":"なんと","l":"なんと"},{"f":"、","p":1},{"f":"車[くるま]","r":"くるま","l":"車"},{"f":"に","r":"に","l":"に"},{"f":"積[つ]みきれない","r":"つみきれない","l":"積む","i":{"en":"〜きれる: can ~ completely (〜きれない: too much to ~) + negative","zh":"〜きれる：能…完（〜きれない：…不完） ＋ 否定"}},{"f":"ほど","r":"ほど","l":"ほど"},{"f":"の","r":"の","l":"の"},{"f":"黄金[おうごん]","r":"おうごん","l":"黄金"},{"f":"が","r":"が","l":"が"},{"f":"出[で]てきた","r":"でてきた","l":"出る","i":{"en":"〜てくる: comes ~ing / has been ~ing + past","zh":"〜てくる：…起来／…过来 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"When he dug as he had been told, lo and behold, out came more gold than a cart could carry.","zh":"他照着老人说的去挖，竟然挖出了一车都装不下的黄金。"},"say":"言われたとおりに掘ってみると、なんと、車に積みきれないほどの黄金が出てきた。","g":[{"id":"kirenai","from":10,"to":10},{"id":"hodo","from":11,"to":11}],"b":[{"from":0,"to":2,"r":"adv","g":{"en":"just as (he) had been told","zh":"按照所说的"},"n":{"en":"〜とおりに \"just as ~\": 言われたとおりに \"exactly as (he) was told\".","zh":"〜とおりに表示“按照…”：言われたとおりに“照着别人说的”。"}},{"from":3,"to":4,"r":"cond","h":"cond:と","g":{"en":"when (he) tried digging","zh":"挖了挖"}},{"from":6,"to":6,"r":"adv","g":{"en":"lo and behold","zh":"竟然"}},{"from":8,"to":12,"r":"mod","h":"mod:の","g":{"en":"more than a cart could carry","zh":"多得车都装不下的"}},{"from":13,"to":14,"r":"subj","h":"subj:が","g":{"en":"gold","zh":"黄金"}},{"from":15,"to":15,"r":"pred","h":"pred","g":{"en":"came out","zh":"冒了出来"}}]}],[{"id":"toshishun/1/11","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"一夜[いちや]","r":"いちや","l":"一夜"},{"f":"に","r":"に","l":"に"},{"f":"して","r":"して","l":"する","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"洛陽[らくよう]","r":"らくよう","l":"洛陽"},{"f":"一[いち]","r":"いち","l":"一"},{"f":"の","r":"の","l":"の"},{"f":"大金持[おおがねも]ち","r":"おおがねもち","l":"大金持ち"},{"f":"に","r":"に","l":"に"},{"f":"なった","r":"なった","l":"なる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"In a single night, Tu Tze-chun became the richest man in Luoyang.","zh":"一夜之间，杜子春成了洛阳首富。"},"say":"とししゅんは一夜にして、らくよう一の大金持ちになった。","g":[{"id":"ni-shite","from":2,"to":4}],"n":[{"from":2,"to":4,"body":{"en":"Time / number + にして stresses how short or how few: 一夜にして \"in a single night\", 一瞬にして \"in an instant\". It is literary.","zh":"时间／数量＋にして强调时间之短或数量之少：一夜にして“一夜之间”，一瞬にして“一瞬间”。书面语。"}}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":2,"to":4,"r":"time","h":"time","g":{"en":"in a single night","zh":"一夜之间"},"n":{"en":"Nにして \"in (just) N\": 一夜にして \"overnight, in a single night\", stressing how fast it happened.","zh":"Nにして表示“仅仅…就”：一夜にして“一夜之间”，强调变化之快。"}},{"from":6,"to":10,"r":"result","h":"result:に","g":{"en":"the richest man in Luoyang","zh":"洛阳首富"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"became","zh":"成了"}}]},{"id":"toshishun/1/12","t":[{"f":"金持[かねも]ち","r":"かねもち","l":"金持ち"},{"f":"に","r":"に","l":"に"},{"f":"なって","r":"なって","l":"なる","i":{"en":"te-form","zh":"て形"}},{"f":"から","r":"から","l":"から"},{"f":"と","r":"と","l":"と"},{"f":"いう","r":"いう","l":"いう"},{"f":"もの","r":"もの","l":"もの"},{"f":"、","p":1},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"の","r":"の","l":"の"},{"f":"家[いえ]","r":"いえ","l":"家"},{"f":"で","r":"で","l":"で"},{"f":"は","r":"は","l":"は"},{"f":"毎晩[まいばん]","r":"まいばん","l":"毎晩"},{"f":"の","r":"の","l":"の"},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"宴会[えんかい]","r":"えんかい","l":"宴会"},{"f":"が","r":"が","l":"が"},{"f":"開[ひら]かれた","r":"ひらかれた","l":"開く","i":{"en":"passive / potential / respectful (〜れる) + past","zh":"被动／可能／尊敬（〜れる） ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"From the moment he became rich, there were banquets at Tu Tze-chun's house almost every night.","zh":"自从他发了财，杜子春家里几乎每晚都大摆宴席。"},"say":"金持ちになってからというもの、とししゅんの家では毎晩のように宴会が開かれた。","g":[{"id":"te-kara-to-iu-mono","from":2,"to":6}],"n":[{"from":2,"to":6,"body":{"en":"V-て + からというもの \"ever since ~\": it stresses that a change happened at that point and has continued since. It is more emotional than 〜てから.","zh":"V-て＋からというもの表示“自从…以来（就一直）”，强调从那时起发生了变化并持续至今，比〜てから更带感情色彩。"}}],"b":[{"from":0,"to":6,"r":"time","h":"time","g":{"en":"ever since (he) became rich","zh":"自从变成有钱人以后"},"n":{"en":"〜てからというもの \"ever since ~ (things have been different)\".","zh":"〜てからというもの表示“自从…以后（就一直…）”。"}},{"from":8,"to":12,"r":"topic","h":"topic:では","g":{"en":"as for at Tu Tze-chun's house","zh":"杜子春家里"}},{"from":13,"to":16,"r":"time","h":"time:に","g":{"en":"nearly every night","zh":"几乎每晚"}},{"from":17,"to":18,"r":"subj","h":"subj:が","g":{"en":"banquets","zh":"宴会"}},{"from":19,"to":19,"r":"pred","h":"pred","g":{"en":"were held","zh":"都举行"}}]},{"id":"toshishun/1/13","t":[{"f":"今[いま]","r":"いま","l":"今"},{"f":"まで","r":"まで","l":"まで"},{"f":"あいさつ","r":"あいさつ","l":"あいさつ"},{"f":"さえ","r":"さえ","l":"さえ"},{"f":"しなかった","r":"しなかった","l":"する","i":{"en":"negative past","zh":"否定过去式"}},{"f":"人[ひと]","r":"ひと","l":"人"},{"f":"たち","r":"たち","l":"たち"},{"f":"が","r":"が","l":"が"},{"f":"、","p":1},{"f":"朝[あさ]","r":"あさ","l":"朝"},{"f":"から","r":"から","l":"から"},{"f":"晩[ばん]","r":"ばん","l":"晩"},{"f":"まで","r":"まで","l":"まで"},{"f":"遊[あそ]び","r":"あそび","l":"遊び"},{"f":"に","r":"に","l":"に"},{"f":"来[く]る","r":"くる","l":"来る"},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"なった","r":"なった","l":"なる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"People who had never even greeted him before now came to enjoy themselves from morning till night.","zh":"以前连招呼都不打的人，现在从早到晚都来找他玩。"},"say":"今まであいさつさえしなかった人たちが、朝から晩まで遊びに来るようになった。","g":[{"id":"sae","from":3,"to":3},{"id":"you-ni-naru","from":15,"to":18}],"b":[{"from":0,"to":4,"r":"mod","h":"mod","g":{"en":"who until then had not even greeted (him)","zh":"以前连招呼都不打的"}},{"from":5,"to":7,"r":"subj","h":"subj:が","g":{"en":"people","zh":"人们"}},{"from":9,"to":10,"r":"from","h":"from:から","g":{"en":"from morning","zh":"从早上"}},{"from":11,"to":12,"r":"until","h":"until:まで","g":{"en":"till night","zh":"到晚上"}},{"from":13,"to":18,"r":"pred","h":"pred","g":{"en":"came to come and have fun","zh":"都来玩了"},"n":{"en":"〜ようになる \"come to ~\": a change in habit.","zh":"〜ようになる表示“变得…”，指习惯的变化。"}}]},{"id":"toshishun/1/14","t":[{"f":"一度[いちど]","r":"いちど","l":"一度"},{"f":"ぜいたく","r":"ぜいたく","l":"ぜいたく"},{"f":"を","r":"を","l":"を"},{"f":"覚[おぼ]えた","r":"おぼえた","l":"覚える","i":{"en":"past","zh":"过去式"}},{"f":"が","r":"が","l":"が:but"},{"f":"最後[さいご]","r":"さいご","l":"最後"},{"f":"、","p":1},{"f":"人[ひと]","r":"ひと","l":"人"},{"f":"は","r":"は","l":"は"},{"f":"もう","r":"もう","l":"もう"},{"f":"元[もと]","r":"もと","l":"元"},{"f":"の","r":"の","l":"の"},{"f":"暮[く]らし","r":"くらし","l":"暮らし"},{"f":"に","r":"に","l":"に"},{"f":"は","r":"は","l":"は"},{"f":"戻[もど]れない","r":"もどれない","l":"戻る","i":{"en":"potential negative: can't ~","zh":"可能态否定：不能…"}},{"f":"。","p":1}],"tr":{"en":"Once you have tasted luxury, there is no going back to the life you had.","zh":"一旦尝到了奢侈的滋味，人就再也回不到原来的生活了。"},"say":"一度ぜいたくを覚えたが最後、人はもう元の暮らしには戻れない。","g":[{"id":"ga-saigo","from":3,"to":5}],"n":[{"from":3,"to":5,"body":{"en":"V-た + が最後 \"once ~, (then something bad and irreversible follows)\". It warns that a single act leads to an outcome you can't undo.","zh":"V-た＋が最後表示“一旦…就（必然产生无法挽回的坏结果）”，强调一次行为导致无法逆转的后果。"}}],"b":[{"from":0,"to":5,"r":"cond","g":{"en":"once (one) has learned luxury","zh":"一旦尝到奢侈的滋味"},"n":{"en":"V-た＋が最後 \"once ~, (there's no going back)\".","zh":"V-た＋が最後表示“一旦…就（无法挽回）”。"}},{"from":7,"to":8,"r":"topic","h":"topic:は","g":{"en":"as for people","zh":"人"}},{"from":9,"to":9,"r":"adv","g":{"en":"any more","zh":"就再也"}},{"from":10,"to":14,"r":"goal","g":{"en":"to the old life","zh":"原来的生活"}},{"from":15,"to":15,"r":"pred","h":"pred","g":{"en":"can't return","zh":"回不去了"}}]},{"id":"toshishun/1/15","t":[{"f":"いくら","r":"いくら","l":"いくら"},{"f":"大金持[おおがねも]ち","r":"おおがねもち","l":"大金持ち"},{"f":"と","r":"と","l":"と"},{"f":"は","r":"は","l":"は"},{"f":"いえ","r":"いえ","l":"いう"},{"f":"、","p":1},{"f":"毎晩[まいばん]","r":"まいばん","l":"毎晩"},{"f":"こんな","r":"こんな","l":"こんな"},{"f":"こと","r":"こと","l":"こと"},{"f":"を","r":"を","l":"を"},{"f":"していて","r":"していて","l":"する","i":{"en":"〜ている: ongoing action or resulting state + te-form","zh":"〜ている：动作进行／状态持续 ＋ て形"}},{"f":"は","r":"は","l":"は"},{"f":"、","p":1},{"f":"お金[かね]","r":"おかね","l":"お金"},{"f":"が","r":"が","l":"が"},{"f":"続[つづ]く","r":"つづく","l":"続く"},{"f":"はず","r":"はず","l":"はず"},{"f":"が","r":"が","l":"が"},{"f":"ない","r":"ない","l":"ない"},{"f":"。","p":1}],"tr":{"en":"However rich he was, his money could not possibly last if he carried on like this every night.","zh":"虽说是大富翁，可每晚都这样挥霍，钱是不可能撑得住的。"},"say":"いくら大金持ちとはいえ、毎晩こんなことをしていては、お金が続くはずがない。","g":[{"id":"to-wa-ie","from":2,"to":4},{"id":"hazu-ga-nai","from":16,"to":18}],"n":[{"from":2,"to":4,"body":{"en":"〜とはいえ \"although, even if it's true that ~\". It admits a fact and then says something that doesn't follow from it. It is written, and more formal than 〜といっても.","zh":"〜とはいえ表示“虽说…但是…”，先承认一个事实，再说出与之不相符的情况。书面语，比〜といっても更正式。"}}],"b":[{"from":0,"to":4,"r":"cond","g":{"en":"however rich (he) may be","zh":"无论多么有钱"},"n":{"en":"〜とはいえ \"although, even if ~\" (written).","zh":"〜とはいえ表示“虽说…，尽管…”（书面）。"}},{"from":6,"to":11,"r":"cond","g":{"en":"if (he) keeps doing this every night","zh":"每晚这样挥霍的话"}},{"from":13,"to":18,"r":"pred","h":"pred","g":{"en":"the money can't possibly last","zh":"钱不可能撑得住"}}]},{"id":"toshishun/1/16","t":[{"f":"三[さん]","r":"さん","l":"三"},{"f":"年[ねん]","r":"ねん","l":"年:ねん"},{"f":"目[め]","r":"め","l":"目"},{"f":"の","r":"の","l":"の"},{"f":"春[はる]","r":"はる","l":"春"},{"f":"、","p":1},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"また","r":"また","l":"また"},{"f":"一文[いちもん]なし","r":"いちもんなし","l":"一文なし"},{"f":"に","r":"に","l":"に"},{"f":"なった","r":"なった","l":"なる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"In the spring of the third year, Tu Tze-chun was penniless once again.","zh":"第三年的春天，杜子春又变得身无分文。"},"say":"三年目の春、とししゅんはまた一文なしになった。","b":[{"from":0,"to":4,"r":"time","h":"time","g":{"en":"in the spring of the third year","zh":"第三年的春天"}},{"from":6,"to":7,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":8,"to":8,"r":"adv","g":{"en":"again","zh":"又"}},{"from":9,"to":10,"r":"result","h":"result:に","g":{"en":"penniless","zh":"一文不名"},"n":{"en":"一文なし \"without a single coin, penniless\".","zh":"一文なし表示“身无分文”。"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"became","zh":"变得"}}]},{"id":"toshishun/1/17","t":[{"f":"すると","r":"すると","l":"すると"},{"f":"、","p":1},{"f":"あれほど","r":"あれほど","l":"あれほど"},{"f":"毎日[まいにち]","r":"まいにち","l":"毎日"},{"f":"来[き]ていた","r":"きていた","l":"来る","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"友人[ゆうじん]","r":"ゆうじん","l":"友人"},{"f":"たち","r":"たち","l":"たち"},{"f":"は","r":"は","l":"は"},{"f":"、","p":1},{"f":"道[みち]","r":"みち","l":"道"},{"f":"で","r":"で","l":"で"},{"f":"会[あ]って","r":"あって","l":"会う","i":{"en":"te-form","zh":"て形"}},{"f":"も","r":"も","l":"も"},{"f":"顔[かお]","r":"かお","l":"顔"},{"f":"を","r":"を","l":"を"},{"f":"そむけて","r":"そむけて","l":"そむける","i":{"en":"te-form","zh":"て形"}},{"f":"通[とお]り過[す]ぎる","r":"とおりすぎる","l":"通り過ぎる"},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"なった","r":"なった","l":"なる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"And the friends who had come every single day now turned their faces away and walked past when they met him in the street.","zh":"于是，那些曾经天天上门的朋友，在路上遇见他也扭过脸去，径直走过。"},"say":"すると、あれほど毎日来ていた友人たちは、道で会っても顔をそむけて通り過ぎるようになった。","b":[{"from":0,"to":0,"r":"conn","g":{"en":"then","zh":"于是"}},{"from":2,"to":4,"r":"mod","h":"mod","g":{"en":"who had come every day like that","zh":"曾经天天来的"}},{"from":5,"to":7,"r":"topic","h":"topic:は","g":{"en":"as for friends","zh":"朋友们"}},{"from":9,"to":12,"r":"cond","g":{"en":"even if (they) met (him) in the street","zh":"即使在路上遇见"}},{"from":13,"to":14,"r":"obj","h":"obj:を","g":{"en":"(their) faces","zh":"脸"},"n":{"en":"顔をそむける \"turn one's face away\".","zh":"顔をそむける表示“扭过脸去”。"}},{"from":15,"to":15,"r":"verb","g":{"en":"turned away, and","zh":"扭过去"}},{"from":16,"to":19,"r":"pred","h":"pred","g":{"en":"came to walk past","zh":"变得擦身而过"}}]}],[{"id":"toshishun/1/18","t":[{"f":"再[ふたた]び","r":"ふたたび","l":"再び"},{"f":"西[にし]","r":"にし","l":"西"},{"f":"の","r":"の","l":"の"},{"f":"門[もん]","r":"もん","l":"門"},{"f":"の","r":"の","l":"の"},{"f":"下[した]","r":"した","l":"下"},{"f":"に","r":"に","l":"に"},{"f":"立[た]った","r":"たった","l":"立つ","i":{"en":"past","zh":"过去式"}},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"の","r":"の","l":"の"},{"f":"前[まえ]","r":"まえ","l":"前"},{"f":"に","r":"に","l":"に"},{"f":"、","p":1},{"f":"あの","r":"あの","l":"あの"},{"f":"片目[かため]","r":"かため","l":"片目"},{"f":"の","r":"の","l":"の"},{"f":"老人[ろうじん]","r":"ろうじん","l":"老人"},{"f":"が","r":"が","l":"が"},{"f":"また","r":"また","l":"また"},{"f":"現[あらわ]れた","r":"あらわれた","l":"現れる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"As Tu Tze-chun stood once more beneath the west gate, the one-eyed old man appeared before him again.","zh":"杜子春再次站在西门下，那个独眼老人又出现在他面前。"},"say":"再び西の門の下に立ったとししゅんの前に、あの片目の老人がまた現れた。","b":[{"from":0,"to":7,"r":"mod","h":"mod","g":{"en":"who again stood beneath the west gate","zh":"再次站在西门下的"}},{"from":8,"to":11,"r":"place","h":"place:に","g":{"en":"in front of Tu Tze-chun","zh":"在杜子春面前"}},{"from":13,"to":17,"r":"subj","h":"subj:が","g":{"en":"that one-eyed old man","zh":"那个独眼老人"}},{"from":18,"to":18,"r":"adv","g":{"en":"again","zh":"又"}},{"from":19,"to":19,"r":"pred","h":"pred","g":{"en":"appeared","zh":"出现了"}}]},{"id":"toshishun/1/19","t":[{"f":"老人[ろうじん]","r":"ろうじん","l":"老人"},{"f":"は","r":"は","l":"は"},{"f":"前[まえ]","r":"まえ","l":"前"},{"f":"と","r":"と","l":"と"},{"f":"同[おな]じ","r":"おなじ","l":"同じ"},{"f":"よう","r":"よう","l":"よう"},{"f":"に","r":"に","l":"に"},{"f":"黄金[おうごん]","r":"おうごん","l":"黄金"},{"f":"の","r":"の","l":"の"},{"f":"ありか","r":"ありか","l":"ありか"},{"f":"を","r":"を","l":"を"},{"f":"教[おし]え","r":"おしえ","l":"教える","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"また","r":"また","l":"また"},{"f":"大金持[おおがねも]ち","r":"おおがねもち","l":"大金持ち"},{"f":"に","r":"に","l":"に"},{"f":"なった","r":"なった","l":"なる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"As before, the old man told him where gold lay hidden, and Tu Tze-chun became enormously rich again.","zh":"老人像上次一样告诉他黄金埋在哪里，杜子春又成了大富翁。"},"say":"老人は前と同じように黄金のありかを教え、とししゅんはまた大金持ちになった。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the old man","zh":"老人"}},{"from":2,"to":6,"r":"adv","g":{"en":"just like before","zh":"和上次一样"}},{"from":7,"to":10,"r":"obj","h":"obj:を","g":{"en":"the gold's whereabouts","zh":"黄金所在之处"}},{"from":11,"to":11,"r":"verb","g":{"en":"told, and","zh":"告诉了他"}},{"from":13,"to":14,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":15,"to":15,"r":"adv","g":{"en":"again","zh":"又"}},{"from":16,"to":17,"r":"result","h":"result:に","g":{"en":"very rich","zh":"大富翁"}},{"from":18,"to":18,"r":"pred","h":"pred","g":{"en":"became","zh":"成了"}}]},{"id":"toshishun/1/20","t":[{"f":"けれども","r":"けれども","l":"けれども"},{"f":"三[さん]","r":"さん","l":"三"},{"f":"年[ねん]","r":"ねん","l":"年:ねん"},{"f":"たつ","r":"たつ","l":"たつ"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"やはり","r":"やはり","l":"やはり"},{"f":"何[なに]もかも","r":"なにもかも","l":"何もかも"},{"f":"失[うしな]ってしまった","r":"うしなってしまった","l":"失う","i":{"en":"〜てしまう: completely / regrettably + past","zh":"〜てしまう：完了／遗憾 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"But after three years, he had lost everything all over again.","zh":"可是三年一过，他还是把一切都输光了。"},"say":"けれども三年たつと、やはり何もかも失ってしまった。","b":[{"from":0,"to":0,"r":"conn","g":{"en":"but","zh":"但是"}},{"from":1,"to":4,"r":"cond","h":"cond:と","g":{"en":"when three years passed","zh":"过了三年"}},{"from":6,"to":6,"r":"adv","g":{"en":"as expected","zh":"果然"}},{"from":7,"to":8,"r":"pred","h":"pred","g":{"en":"lost everything","zh":"又失去了一切"}}]},{"id":"toshishun/1/21","t":[{"f":"三度目[さんどめ]","r":"さんどめ","l":"三度目"},{"f":"に","r":"に","l":"に"},{"f":"老人[ろうじん]","r":"ろうじん","l":"老人"},{"f":"が","r":"が","l":"が"},{"f":"現[あらわ]れた","r":"あらわれた","l":"現れる","i":{"en":"past","zh":"过去式"}},{"f":"時[とき]","r":"とき","l":"時"},{"f":"、","p":1},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"首[くび]","r":"くび","l":"首"},{"f":"を","r":"を","l":"を"},{"f":"横[よこ]","r":"よこ","l":"横"},{"f":"に","r":"に","l":"に"},{"f":"振[ふ]った","r":"ふった","l":"振る","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"When the old man appeared for the third time, Tu Tze-chun shook his head.","zh":"老人第三次出现时，杜子春摇了摇头。"},"say":"三度目に老人が現れた時、とししゅんは首を横に振った。","b":[{"from":0,"to":5,"r":"time","h":"time","g":{"en":"when the old man appeared for the third time","zh":"老人第三次出现时"}},{"from":7,"to":8,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":9,"to":10,"r":"obj","h":"obj:を","g":{"en":"his head","zh":"头"}},{"from":11,"to":12,"r":"goal","h":"goal:に","g":{"en":"sideways","zh":"往两边"}},{"from":13,"to":13,"r":"pred","h":"pred","g":{"en":"shook","zh":"摇了摇"}}]},{"id":"toshishun/1/22","t":[{"f":"「","p":1},{"f":"もう","r":"もう","l":"もう"},{"f":"お金[かね]","r":"おかね","l":"お金"},{"f":"は","r":"は","l":"は"},{"f":"いりません","r":"いりません","l":"いる","i":{"en":"polite negative","zh":"礼貌体否定"}},{"f":"。","p":1},{"f":"お金[かね]","r":"おかね","l":"お金"},{"f":"が","r":"が","l":"が"},{"f":"ある","r":"ある","l":"ある"},{"f":"時[とき]","r":"とき","l":"時"},{"f":"は","r":"は","l":"は"},{"f":"寄[よ]ってきて","r":"よってきて","l":"寄る","i":{"en":"〜てくる: comes ~ing / has been ~ing + te-form","zh":"〜てくる：…起来／…过来 ＋ て形"}},{"f":"、","p":1},{"f":"なくなる","r":"なくなる","l":"なくなる"},{"f":"と","r":"と","l":"と"},{"f":"離[はな]れていく","r":"はなれていく","l":"離れる","i":{"en":"〜ていく: goes on ~ing / away from now","zh":"〜ていく：…下去"}},{"f":"。","p":1},{"f":"そんな","r":"そんな","l":"そんな"},{"f":"人間[にんげん]","r":"にんげん","l":"人間"},{"f":"に","r":"に","l":"に"},{"f":"、","p":1},{"f":"わたし","r":"わたし","l":"わたし"},{"f":"は","r":"は","l":"は"},{"f":"あきあき","r":"あきあき","l":"あきあき"},{"f":"しました","r":"しました","l":"する","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"」","p":1}],"tr":{"en":"\"I don't want any more money. People flock to you when you have it and leave you when it's gone. I'm sick of people like that.\"","zh":"“我不要钱了。有钱的时候都凑过来，没钱了就离你而去。这样的人，我已经厌倦了。”"},"say":"「もうお金はいりません。お金がある時は寄ってきて、なくなると離れていく。そんな人間に、わたしはあきあきしました」","who":"toshishun","b":[{"from":1,"to":1,"r":"adv","g":{"en":"any more","zh":"再也"}},{"from":2,"to":3,"r":"topic","h":"topic:は","g":{"en":"as for money","zh":"钱"}},{"from":4,"to":4,"r":"pred","h":"pred","g":{"en":"(I) don't need","zh":"不需要了"}},{"from":6,"to":15,"r":"mod","h":"mod","g":{"en":"who come close when there's money and leave when it's gone","zh":"有钱时凑上来、没钱了就离开的"},"n":{"en":"A long description before そんな人間, built from two contrasting halves: \"come close when there's money / leave when it's gone\".","zh":"そんな人間前面的长修饰语由两个对比的部分组成：“有钱时凑上来／没钱了就离开”。"}},{"from":17,"to":19,"r":"goal","h":"goal:に","g":{"en":"with such people","zh":"对这样的人"}},{"from":21,"to":22,"r":"topic","h":"topic:は","g":{"en":"as for me","zh":"我"}},{"from":23,"to":24,"r":"pred","h":"pred","g":{"en":"am fed up","zh":"厌烦透了"}}]},{"id":"toshishun/1/23","t":[{"f":"「","p":1},{"f":"あなた","r":"あなた","l":"あなた"},{"f":"は","r":"は","l":"は"},{"f":"仙人[せんにん]","r":"せんにん","l":"仙人"},{"f":"でしょう","r":"でしょう","l":"です","i":{"en":"〜でしょう: probably","zh":"〜でしょう：大概…吧"}},{"f":"。","p":1},{"f":"どうか","r":"どうか","l":"どうか"},{"f":"わたし","r":"わたし","l":"わたし"},{"f":"を","r":"を","l":"を"},{"f":"弟子[でし]","r":"でし","l":"弟子"},{"f":"に","r":"に","l":"に"},{"f":"してください","r":"してください","l":"する","i":{"en":"〜てください: please do","zh":"〜てください：请…"}},{"f":"」","p":1}],"tr":{"en":"\"You are a hermit sage, aren't you? Please, take me as your disciple.\"","zh":"“您是仙人吧。求您收我为徒。”"},"say":"「あなたは仙人でしょう。どうかわたしを弟子にしてください」","n":[{"from":3,"to":3,"body":{"en":"A 仙人 is a Taoist immortal or hermit sage who lives in the mountains and has magical powers.","zh":"仙人是住在深山中、拥有法力的道教神仙。"}}],"who":"toshishun","b":[{"from":1,"to":2,"r":"topic","h":"topic:は","g":{"en":"as for you","zh":"您"}},{"from":3,"to":4,"r":"pred","h":"pred","g":{"en":"are a sage, aren't you","zh":"是仙人吧"}},{"from":6,"to":6,"r":"adv","g":{"en":"please","zh":"请您"}},{"from":7,"to":8,"r":"obj","h":"obj:を","g":{"en":"me","zh":"我"}},{"from":9,"to":10,"r":"result","h":"result:に","g":{"en":"(your) disciple","zh":"收为弟子"},"n":{"en":"AをBにする \"make A into B\": わたしを弟子にする \"take me as a disciple\".","zh":"AをBにする表示“把A变成B”：わたしを弟子にする“收我为弟子”。"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"make","zh":"吧"}}]},{"id":"toshishun/1/24","t":[{"f":"老人[ろうじん]","r":"ろうじん","l":"老人"},{"f":"は","r":"は","l":"は"},{"f":"にやりと","r":"にやりと","l":"にやりと"},{"f":"笑[わら]った","r":"わらった","l":"笑う","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1},{"f":"「","p":1},{"f":"いかにも","r":"いかにも","l":"いかにも"},{"f":"、","p":1},{"f":"わし","r":"わし","l":"わし"},{"f":"は","r":"は","l":"は"},{"f":"峨眉山[がびさん]","r":"がびさん","l":"峨眉山"},{"f":"に","r":"に","l":"に"},{"f":"住[す]む","r":"すむ","l":"住む"},{"f":"仙人[せんにん]","r":"せんにん","l":"仙人"},{"f":"、","p":1},{"f":"鉄冠子[てっかんし]","r":"てっかんし","l":"鉄冠子"},{"f":"だ","r":"だ","l":"だ"},{"f":"」","p":1}],"tr":{"en":"The old man grinned. \"Indeed I am. I am Tekkanshi, the sage who lives on Mount Emei.\"","zh":"老人咧嘴一笑。“不错，我就是住在峨眉山的仙人铁冠子。”"},"say":"老人はにやりと笑った。「いかにも、わしはがびさんに住む仙人、てっかんしだ」","n":[{"from":8,"to":8,"body":{"en":"わし is an old man's word for \"I\", common in folk tales and old-fashioned speech.","zh":"わし是老年男性的自称，在民间故事和旧式说话中很常见。"}}],"who":"tekkanshi","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the old man","zh":"老人"}},{"from":2,"to":2,"r":"adv","g":{"en":"with a grin","zh":"咧嘴"}},{"from":3,"to":3,"r":"pred","h":"pred","g":{"en":"smiled","zh":"一笑"}},{"from":6,"to":6,"r":"adv","g":{"en":"indeed","zh":"正是"},"n":{"en":"いかにも here is an old way of saying \"indeed, quite so\".","zh":"这里的いかにも是“正是如此”的旧式说法。"}},{"from":8,"to":9,"r":"topic","h":"topic:は","g":{"en":"as for me","zh":"我"}},{"from":10,"to":12,"r":"mod","h":"mod","g":{"en":"who lives on Mount Emei","zh":"住在峨眉山的"}},{"from":13,"to":16,"r":"pred","h":"pred","g":{"en":"am the sage Tekkanshi","zh":"仙人铁冠子"}}]}]],"newGrammar":["ni-shite","te-kara-to-iu-mono","ga-saigo",