e","g":{"en":"just then","zh":"就在这时"}},{"from":3,"to":6,"r":"from","h":"from:から","g":{"en":"from behind (him)","zh":"从背后"}},{"from":8,"to":16,"r":"quote","h":"quote:と","g":{"en":"\"who is that there?\"","zh":"“在那里的是什么人？”"}},{"from":17,"to":17,"r":"mod","h":"mod","g":{"en":"shouting harshly","zh":"厉声呵斥的"}},{"from":18,"to":19,"r":"subj","h":"subj:が","g":{"en":"a voice","zh":"声音"}},{"from":20,"to":20,"r":"pred","h":"pred","g":{"en":"was heard","zh":"传来"}}]},{"id":"toshishun/2/10","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"鉄冠子[てっかんし]","r":"てっかんし","l":"鉄冠子"},{"f":"の","r":"の","l":"の"},{"f":"言葉[ことば]","r":"ことば","l":"言葉"},{"f":"を","r":"を","l":"を"},{"f":"思[おも]い出[だ]し","r":"おもいだし","l":"思い出す","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"黙[だま]っていた","r":"だまっていた","l":"黙る","i":{"en":"〜ている: ongoing action or resulting state + past","zh":"〜ている：动作进行／状态持续 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"Tu Tze-chun remembered Tekkanshi's words and said nothing.","zh":"杜子春想起铁冠子的话，一声不吭。"},"say":"とししゅんはてっかんしの言葉を思い出し、黙っていた。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":2,"to":5,"r":"obj","h":"obj:を","g":{"en":"Tekkanshi's words","zh":"铁冠子的话"}},{"from":6,"to":6,"r":"verb","g":{"en":"remembered, and","zh":"想起"}},{"from":8,"to":8,"r":"pred","h":"pred","g":{"en":"stayed silent","zh":"一声不吭"}}]},{"id":"toshishun/2/11","t":[{"f":"すると","r":"すると","l":"すると"},{"f":"岩[いわ]","r":"いわ","l":"岩"},{"f":"の","r":"の","l":"の"},{"f":"上[うえ]","r":"うえ","l":"上"},{"f":"に","r":"に","l":"に"},{"f":"一匹[いっぴき]","r":"いっぴき","l":"一匹"},{"f":"の","r":"の","l":"の"},{"f":"虎[とら]","r":"とら","l":"虎"},{"f":"が","r":"が","l":"が"},{"f":"現[あらわ]れ","r":"あらわれ","l":"現れる","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"今[いま]にも","r":"いまにも","l":"今にも"},{"f":"飛[と]びかからん","r":"とびかからん","l":"飛びかかる","i":{"en":"negative","zh":"否定"}},{"f":"ばかり","r":"ばかり","l":"ばかり"},{"f":"に","r":"に","l":"に"},{"f":"うなり声[ごえ]","r":"うなりごえ","l":"うなり声"},{"f":"を","r":"を","l":"を"},{"f":"あげた","r":"あげた","l":"あげる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"Then a tiger appeared on the rock and roared, as if it were about to spring at him at any moment.","zh":"接着，岩石上出现了一只老虎，咆哮着，仿佛随时都要扑过来。"},"say":"すると岩の上に一匹の虎が現れ、今にも飛びかからんばかりにうなり声をあげた。","g":[{"id":"nbakari","from":12,"to":13}],"b":[{"from":0,"to":0,"r":"conn","g":{"en":"then","zh":"于是"}},{"from":1,"to":4,"r":"place","h":"place:に","g":{"en":"on the rock","zh":"岩石上"}},{"from":5,"to":8,"r":"subj","h":"subj:が","g":{"en":"a tiger","zh":"一只老虎"}},{"from":9,"to":9,"r":"verb","g":{"en":"appeared, and","zh":"出现了"}},{"from":11,"to":14,"r":"adv","g":{"en":"as if about to pounce at any moment","zh":"眼看就要扑过来似的"},"n":{"en":"V-ない stem＋んばかりに \"as if about to V\".","zh":"动词ない形词干＋んばかりに表示“眼看就要…似的”。"}},{"from":15,"to":16,"r":"obj","h":"obj:を","g":{"en":"a roar","zh":"吼声"}},{"from":17,"to":17,"r":"pred","h":"pred","g":{"en":"let out","zh":"发出了"}}]},{"id":"toshishun/2/12","t":[{"f":"同時[どうじ]に","r":"どうじに","l":"同時に"},{"f":"、","p":1},{"f":"大[おお]きな","r":"おおきな","l":"大きな"},{"f":"白[しろ]い","r":"しろい","l":"白い"},{"f":"蛇[へび]","r":"へび","l":"蛇"},{"f":"が","r":"が","l":"が"},{"f":"炎[ほのお]","r":"ほのお","l":"炎"},{"f":"の","r":"の","l":"の"},{"f":"よう","r":"よう","l":"よう"},{"f":"な","r":"な","l":"な"},{"f":"舌[した]","r":"した","l":"舌"},{"f":"を","r":"を","l":"を"},{"f":"出[だ]しながら","r":"だしながら","l":"出す","i":{"en":"〜ながら: while ~ing","zh":"〜ながら：一边…一边"}},{"f":"、","p":1},{"f":"すぐ","r":"すぐ","l":"すぐ"},{"f":"そば","r":"そば","l":"そば"},{"f":"まで","r":"まで","l":"まで"},{"f":"はい寄[よ]ってきた","r":"はいよってきた","l":"はい寄る","i":{"en":"〜てくる (towards here) + past","zh":"〜てくる（朝这边）＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"At the same time, a huge white snake, flicking a tongue like a flame, slithered right up beside him.","zh":"同时，一条巨大的白蛇吐着火焰般的舌头，爬到了他身边。"},"say":"同時に、大きな白い蛇が炎のような舌を出しながら、すぐそばまではい寄ってきた。","b":[{"from":0,"to":0,"r":"time","h":"time","g":{"en":"at the same time","zh":"同时"}},{"from":2,"to":5,"r":"subj","h":"subj:が","g":{"en":"a big white snake","zh":"一条大白蛇"}},{"from":6,"to":11,"r":"obj","h":"obj:を","g":{"en":"a tongue like a flame","zh":"火焰般的舌头"}},{"from":12,"to":12,"r":"adv","g":{"en":"while putting out","zh":"一边吐着"}},{"from":14,"to":16,"r":"until","h":"until:まで","g":{"en":"right up close","zh":"一直到身边"}},{"from":17,"to":17,"r":"pred","h":"pred","g":{"en":"slithered up","zh":"爬了过来"}}]},{"id":"toshishun/2/13","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"恐[おそ]ろしさ","r":"おそろしさ","l":"恐ろしい","i":{"en":"〜さ (noun: degree of)","zh":"〜さ（名词化：程度）"}},{"f":"を","r":"を","l":"を"},{"f":"ものともせず","r":"ものともせず","l":"ものともせず"},{"f":"、","p":1},{"f":"じっと","r":"じっと","l":"じっと"},{"f":"座[すわ]りつづけた","r":"すわりつづけた","l":"座る","i":{"en":"〜続ける: keep on ~ing + past","zh":"〜続ける：继续… ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"Undaunted by his terror, Tu Tze-chun went on sitting perfectly still.","zh":"杜子春不顾恐惧，一动不动地继续坐着。"},"say":"とししゅんは恐ろしさをものともせず、じっと座りつづけた。","g":[{"id":"wo-monotomo-sezu","from":3,"to":4}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":2,"to":4,"r":"adv","g":{"en":"making nothing of his fear","zh":"不顾恐惧"},"n":{"en":"〜をものともせず \"in defiance of ~, undaunted by ~\".","zh":"〜をものともせず表示“不顾…，不把…当回事”。"}},{"from":6,"to":6,"r":"adv","g":{"en":"still","zh":"一动不动地"}},{"from":7,"to":7,"r":"pred","h":"pred","g":{"en":"kept sitting","zh":"继续坐着"}}]},{"id":"toshishun/2/14","t":[{"f":"虎[とら]","r":"とら","l":"虎"},{"f":"と","r":"と","l":"と"},{"f":"蛇[へび]","r":"へび","l":"蛇"},{"f":"が","r":"が","l":"が"},{"f":"消[き]えた","r":"きえた","l":"消える","i":{"en":"past","zh":"过去式"}},{"f":"か","r":"か","l":"か"},{"f":"と","r":"と","l":"と"},{"f":"思[おも]う","r":"おもう","l":"思う"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"今度[こんど]","r":"こんど","l":"今度"},{"f":"は","r":"は","l":"は"},{"f":"激[はげ]しい","r":"はげしい","l":"激しい"},{"f":"雷[かみなり]","r":"かみなり","l":"雷"},{"f":"が","r":"が","l":"が"},{"f":"鳴[な]り","r":"なり","l":"鳴る","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"滝[たき]","r":"たき","l":"滝"},{"f":"の","r":"の","l":"の"},{"f":"よう","r":"よう","l":"よう"},{"f":"な","r":"な","l":"な"},{"f":"雨[あめ]","r":"あめ","l":"雨"},{"f":"が","r":"が","l":"が"},{"f":"降[ふ]ってきた","r":"ふってきた","l":"降る","i":{"en":"〜てくる: comes ~ing / has been ~ing + past","zh":"〜てくる：…起来／…过来 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"No sooner had the tiger and the snake disappeared than thunder crashed and rain poured down like a waterfall.","zh":"老虎和蛇刚一消失，接着又雷声大作，暴雨如瀑布般倾泻而下。"},"say":"虎と蛇が消えたかと思うと、今度は激しい雷が鳴り、滝のような雨が降ってきた。","n":[{"from":5,"to":8,"body":{"en":"〜かと思うと \"no sooner had ~ than\", for two things that happen one right after the other, the second often surprising.","zh":"〜かと思うと表示“刚…就…”，两件事几乎同时接连发生，后一件常出人意料。"}}],"b":[{"from":0,"to":8,"r":"cond","h":"cond:と","g":{"en":"no sooner had the tiger and snake vanished than","zh":"老虎和蛇刚一消失"},"n":{"en":"〜たかと思うと \"no sooner had ~ than…\": two things happen almost at once.","zh":"〜たかと思うと表示“刚…就…”，两件事几乎同时发生。"}},{"from":10,"to":11,"r":"topic","h":"topic:は","g":{"en":"as for this time","zh":"这回"}},{"from":12,"to":14,"r":"subj","h":"subj:が","g":{"en":"fierce thunder","zh":"猛烈的雷"}},{"from":15,"to":15,"r":"verb","g":{"en":"roared, and","zh":"轰鸣"}},{"from":17,"to":22,"r":"subj","h":"subj:が","g":{"en":"rain like a waterfall","zh":"瀑布般的大雨"}},{"from":23,"to":23,"r":"pred","h":"pred","g":{"en":"came pouring down","zh":"倾泻而下"}}]},{"id":"toshishun/2/15","t":[{"f":"これ","r":"これ","l":"これ"},{"f":"も","r":"も","l":"も"},{"f":"仙人[せんにん]","r":"せんにん","l":"仙人"},{"f":"に","r":"に","l":"に"},{"f":"なる","r":"なる","l":"なる"},{"f":"ため","r":"ため","l":"ため"},{"f":"の","r":"の","l":"の"},{"f":"試練[しれん]","r":"しれん","l":"試練"},{"f":"に","r":"に","l":"に"},{"f":"ほかならない","r":"ほかならない","l":"ほかならない"},{"f":"、","p":1},{"f":"と","r":"と","l":"と"},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"自分[じぶん]","r":"じぶん","l":"自分"},{"f":"に","r":"に","l":"に"},{"f":"言[い]い聞[き]かせた","r":"いいきかせた","l":"言い聞かせる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"This too, Tu Tze-chun told himself, was nothing other than a trial on the way to becoming a sage.","zh":"杜子春告诉自己，这也不过是成仙路上的考验。"},"say":"これも仙人になるための試練にほかならない、ととししゅんは自分に言い聞かせた。","g":[{"id":"ni-hoka-naranai","from":8,"to":9}],"n":[{"from":8,"to":9,"body":{"en":"N + にほかならない \"is nothing other than, is none other than\": it states firmly that something is exactly that and nothing else. It is formal and written.","zh":"名词＋にほかならない表示“不外乎是…、正是…”，断定事情正是如此，别无其他。正式的书面语。"}}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:も","g":{"en":"this too","zh":"这也"}},{"from":2,"to":11,"r":"quote","h":"quote:と","g":{"en":"\"is nothing other than a trial for becoming a sage\"","zh":"“无非是成仙的考验”"},"n":{"en":"〜にほかならない \"is nothing other than ~, is precisely ~\".","zh":"〜にほかならない表示“无非是…，正是…”。"}},{"from":12,"to":13,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":14,"to":15,"r":"goal","h":"goal:に","g":{"en":"to himself","zh":"对自己"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"told","zh":"说"}}]},{"id":"toshishun/2/16","t":[{"f":"やがて","r":"やがて","l":"やがて"},{"f":"嵐[あらし]","r":"あらし","l":"嵐"},{"f":"が","r":"が","l":"が"},{"f":"やむ","r":"やむ","l":"やむ"},{"f":"や否[いな]や","r":"やいなや","l":"や否や"},{"f":"、","p":1},{"f":"金[きん]","r":"きん","l":"金"},{"f":"の","r":"の","l":"の"},{"f":"よろい","r":"よろい","l":"よろい"},{"f":"を","r":"を","l":"を"},{"f":"着[き]た","r":"きた","l":"着る","i":{"en":"past","zh":"过去式"}},{"f":"大[おお]きな","r":"おおきな","l":"大きな"},{"f":"神将[しんしょう]","r":"しんしょう","l":"神将"},{"f":"が","r":"が","l":"が"},{"f":"、","p":1},{"f":"三[み]つまた","r":"みつまた","l":"三つまた"},{"f":"の","r":"の","l":"の"},{"f":"戟[げき]","r":"げき","l":"戟"},{"f":"を","r":"を","l":"を"},{"f":"手[て]","r":"て","l":"手"},{"f":"に","r":"に","l":"に"},{"f":"現[あらわ]れた","r":"あらわれた","l":"現れる","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"The moment the storm died down, a giant divine warrior in golden armour appeared, holding a three-pronged halberd.","zh":"暴风雨刚一停，一位身穿金甲的高大神将就手持三叉戟出现了。"},"say":"やがて嵐がやむや否や、金のよろいを着た大きな神将が、三つまたの戟を手に現れた。","g":[{"id":"ya-ina-ya","from":4,"to":4}],"b":[{"from":0,"to":0,"r":"time","h":"time","g":{"en":"soon","zh":"不久"}},{"from":1,"to":4,"r":"time","h":"time","g":{"en":"the moment the storm stopped","zh":"暴风雨刚一停"},"n":{"en":"〜や否や \"the moment ~, no sooner ~ than…\".","zh":"〜や否や表示“刚一…就…”。"}},{"from":6,"to":10,"r":"mod","h":"mod","g":{"en":"wearing golden armour","zh":"身穿金甲的"}},{"from":11,"to":13,"r":"subj","h":"subj:が","g":{"en":"a giant divine warrior","zh":"高大神将"}},{"from":15,"to":20,"r":"adv","g":{"en":"with a three-pronged halberd in hand","zh":"手持三叉戟"}},{"from":21,"to":21,"r":"pred","h":"pred","g":{"en":"appeared","zh":"出现了"}}]},{"id":"toshishun/2/17","t":[{"f":"「","p":1},{"f":"お前[まえ]","r":"おまえ","l":"お前"},{"f":"は","r":"は","l":"は"},{"f":"何者[なにもの]","r":"なにもの","l":"何者"},{"f":"だ","r":"だ","l":"だ"},{"f":"。","p":1},{"f":"答[こた]えなければ","r":"こたえなければ","l":"答える","i":{"en":"〜なければ: if not","zh":"〜なければ：如果不…"}},{"f":"、","p":1},{"f":"命[いのち]","r":"いのち","l":"命"},{"f":"は","r":"は","l":"は"},{"f":"ない","r":"ない","l":"ない"},{"f":"ぞ","r":"ぞ","l":"ぞ"},{"f":"」","p":1}],"tr":{"en":"\"Who are you? Answer, or you die.\"","zh":"“你是什么人？不回答，就要你的命！”"},"say":"「お前は何者だ。答えなければ、命はないぞ」","g":[{"id":"ba-conditional","from":6,"to":6}],"who":"shinsho","b":[{"from":1,"to":2,"r":"topic","h":"topic:は","g":{"en":"as for you","zh":"你"}},{"from":3,"to":4,"r":"pred","h":"pred","g":{"en":"who are you?","zh":"是什么人？"}},{"from":6,"to":6,"r":"cond","h":"cond:ば","g":{"en":"if (you) don't answer","zh":"不回答的话"}},{"from":8,"to":11,"r":"pred","h":"pred","g":{"en":"you're dead","zh":"就要你的命"},"n":{"en":"命はない \"there will be no life (for you)\", a threat: \"you're dead\".","zh":"命はない“你就没命了”，是威胁的话。"}}]},{"id":"toshishun/2/18","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"は","r":"は","l":"は"},{"f":"口[くち]","r":"くち","l":"口"},{"f":"を","r":"を","l":"を"},{"f":"固[かた]く","r":"かたく","l":"固い","i":{"en":"〜く: adverbial / continuing","zh":"〜く：副词用法／中顿"}},{"f":"閉[と]じた","r":"とじた","l":"閉じる","i":{"en":"past","zh":"过去式"}},{"f":"まま","r":"まま","l":"まま"},{"f":"、","p":1},{"f":"何[なに]","r":"なに","l":"何"},{"f":"も","r":"も","l":"も"},{"f":"答[こた]えなかった","r":"こたえなかった","l":"答える","i":{"en":"negative past","zh":"否定过去式"}},{"f":"。","p":1}],"tr":{"en":"Tu Tze-chun kept his mouth tightly shut and answered nothing.","zh":"杜子春紧闭着嘴，什么也没回答。"},"say":"とししゅんは口を固く閉じたまま、何も答えなかった。","g":[{"id":"mama","from":5,"to":6}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun","zh":"杜子春"}},{"from":2,"to":6,"r":"adv","g":{"en":"with his mouth still shut tight","zh":"紧闭着嘴"}},{"from":8,"to":9,"r":"obj","h":"obj:も","g":{"en":"nothing","zh":"什么也"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"answered","zh":"没回答"}}]},{"id":"toshishun/2/19","t":[{"f":"神将[しんしょう]","r":"しんしょう","l":"神将"},{"f":"は","r":"は","l":"は"},{"f":"怒[おこ]って","r":"おこって","l":"怒る","i":{"en":"te-form","zh":"て形"}},{"f":"戟[げき]","r":"げき","l":"戟"},{"f":"を","r":"を","l":"を"},{"f":"振[ふ]り上[あ]げ","r":"ふりあげ","l":"振り上げる","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"を","r":"を","l":"を"},{"f":"一突[ひとつ]き","r":"ひとつき","l":"一突き"},{"f":"に","r":"に","l":"に"},{"f":"した","r":"した","l":"する","i":{"en":"past","zh":"过去式"}},{"f":"。","p":1}],"tr":{"en":"The warrior raised his halberd in fury and ran Tu Tze-chun through with a single thrust.","zh":"神将大怒，举起戟一下刺穿了杜子春。"},"say":"神将は怒って戟を振り上げ、とししゅんを一突きにした。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for the warrior","zh":"神将"}},{"from":2,"to":2,"r":"verb","g":{"en":"grew angry, and","zh":"大怒"}},{"from":3,"to":4,"r":"obj","h":"obj:を","g":{"en":"the halberd","zh":"戟"}},{"from":5,"to":5,"r":"verb","g":{"en":"raised, and","zh":"举起"}},{"from":7,"to":8,"r":"obj","h":"obj:を","g":{"en":"Tu Tze-chun","zh":"杜子春"}},{"from":9,"to":10,"r":"result","h":"result:に","g":{"en":"with one thrust","zh":"一戟"},"n":{"en":"〜を一突きにする \"run someone through with a single thrust\".","zh":"〜を一突きにする表示“一下刺穿…”。"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"ran (him) through","zh":"刺穿了"}}]},{"id":"toshishun/2/20","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"の","r":"の","l":"の"},{"f":"体[からだ]","r":"からだ","l":"体"},{"f":"は","r":"は","l":"は"},{"f":"岩[いわ]","r":"いわ","l":"岩"},{"f":"の","r":"の","l":"の"},{"f":"上[うえ]","r":"うえ","l":"上"},{"f":"に","r":"に","l":"に"},{"f":"倒[たお]れ","r":"たおれ","l":"倒れる","i":{"en":"masu-stem: and / continuing","zh":"连用形：中顿／连接"}},{"f":"、","p":1},{"f":"その","r":"その","l":"その"},{"f":"魂[たましい]","r":"たましい","l":"魂"},{"f":"は","r":"は","l":"は"},{"f":"静[しず]か","r":"しずか","l":"静か"},{"f":"に","r":"に","l":"に"},{"f":"体[からだ]","r":"からだ","l":"体"},{"f":"を","r":"を","l":"を"},{"f":"抜[ぬ]け出[だ]して","r":"ぬけだして","l":"抜け出す","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"地獄[じごく]","r":"じごく","l":"地獄"},{"f":"の","r":"の","l":"の"},{"f":"底[そこ]","r":"そこ","l":"底"},{"f":"へ","r":"へ","l":"へ"},{"f":"と","r":"と","l":"と"},{"f":"落[お]ちていった","r":"おちていった","l":"落ちる","i":{"en":"〜ていく: goes on ~ing / away from now + past","zh":"〜ていく：…下去 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"Tu Tze-chun's body fell on the rock, and his soul quietly left it and sank down to the depths of hell.","zh":"杜子春的身体倒在岩石上，他的魂魄静静地离开了身体，坠入了地狱深处。"},"say":"とししゅんの体は岩の上に倒れ、その魂は静かに体を抜け出して、地獄の底へと落ちていった。","b":[{"from":0,"to":3,"r":"topic","h":"topic:は","g":{"en":"as for Tu Tze-chun's body","zh":"杜子春的身体"}},{"from":4,"to":7,"r":"goal","h":"goal:に","g":{"en":"onto the rock","zh":"倒在岩石上"}},{"from":8,"to":8,"r":"verb","g":{"en":"fell, and","zh":"倒下"}},{"from":10,"to":12,"r":"topic","h":"topic:は","g":{"en":"as for his soul","zh":"他的魂魄"}},{"from":13,"to":14,"r":"adv","g":{"en":"quietly","zh":"静静地"}},{"from":15,"to":16,"r":"obj","h":"obj:を","g":{"en":"the body","zh":"身体"},"n":{"en":"を with 抜け出す marks what you leave: 体を抜け出す \"slip out of the body\".","zh":"を与抜け出す连用时表示离开的地方：体を抜け出す“脱离身体”。"}},{"from":17,"to":17,"r":"verb","g":{"en":"slipped out of, and","zh":"脱离"}},{"from":19,"to":23,"r":"goal","g":{"en":"to the bottom of Hell","zh":"向地狱深处"}},{"from":24,"to":24,"r":"pred","h":"pred","g":{"en":"fell away","zh":"坠了下去"}}]}]],"newGrammar":["to-areba","nari","ni-hoka-naranai"],"newVocab":["青竹"