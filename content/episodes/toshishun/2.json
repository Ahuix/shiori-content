":{"en":"but","zh":"但是"}},{"from":3,"to":6,"r":"cond","g":{"en":"whatever happens","zh":"无论发生什么"}},{"from":8,"to":8,"r":"adv","g":{"en":"never","zh":"绝对"}},{"from":9,"to":13,"r":"pred","h":"pred","g":{"en":"you must not make a sound","zh":"不许出声"},"n":{"en":"〜てはならぬ = 〜てはならない \"must not ~\" (ぬ is the old ない).","zh":"〜てはならぬ＝〜てはならない“不许…”（ぬ是古语的ない）。"}},{"from":15,"to":21,"r":"cond","g":{"en":"once you say even one word","zh":"只要说一个字"}},{"from":23,"to":24,"r":"topic","h":"topic:は","g":{"en":"as for you","zh":"你"}},{"from":25,"to":30,"r":"pred","h":"pred","g":{"en":"can never become a sage","zh":"就成不了仙人"}}]},{"id":"toshishun/2/6","t":[{"f":"「","p":1},{"f":"仙人[せんにん]","r":"せんにん","l":"仙人"},{"f":"に","r":"に","l":"に"},{"f":"なれる","r":"なれる","l":"なる","i":{"en":"potential: can ~","zh":"可能态：能…"}},{"f":"と","r":"と","l":"と"},{"f":"あれば","r":"あれば","l":"ある","i":{"en":"conditional (〜ば)","zh":"假定形（〜ば）"}},{"f":"、","p":1},{"f":"たとえ","r":"たとえ","l":"たとえ"},{"f":"命[いのち]","r":"いのち","l":"命"},{"f":"を","r":"を","l":"を"},{"f":"落[お]として","r":"おとして","l":"落とす","i":{"en":"te-form","zh":"て形"}},{"f":"も","r":"も","l":"も"},{"f":"、","p":1},{"f":"決[けっ]して","r":"けっして","l":"決して"},{"f":"声[こえ]","r":"こえ","l":"声"},{"f":"は","r":"は","l":"は"},{"f":"出[だ]しません","r":"だしません","l":"出す","i":{"en":"polite negative","zh":"礼貌体否定"}},{"f":"」","p":1}],"tr":{"en":"\"If it means I can become a sage, I will never make a sound, even if it costs me my life.\"","zh":"“只要能成为仙人，就算丢了性命，我也绝不出声。”"},"say":"「仙人になれるとあれば、たとえ命を落としても、決して声は出しません」","g":[{"id":"to-areba","from":3,"to":5},{"id":"tatoe-temo","from":7,"to":7},{"id":"tatoe-temo","from":10,"to":11}],"n":[{"from":3,"to":5,"body":{"en":"〜とあれば \"if it is (for) ~, then (I'll do anything)\". It shows strong willingness for the sake of something special. It is formal and a little old-fashioned.","zh":"〜とあれば表示“如果是为了…的话（什么都愿意做）”，带有为了某个特别目的而全力以赴的语气，正式且略显古旧。"}}],"who":"toshishun","b":[{"from":1,"to":5,"r":"cond","h":"cond:ば","g":{"en":"if it's (so that) I can become a sage","zh":"如果能成仙的话"},"n":{"en":"〜とあれば \"if it's for ~, if that's the case\": he would do anything for it.","zh":"〜とあれば表示“如果是为了…”：为此什么都愿意做。"}},{"from":7,"to":11,"r":"cond","g":{"en":"even if I lose my life","zh":"即使丢了性命"}},{"from":13,"to":13,"r":"adv","g":{"en":"never","zh":"绝对"}},{"from":14,"to":15,"r":"topic","h":"topic:は","g":{"en":"as for my voice","zh":"声音"}},{"from":16,"to":16,"r":"pred","h":"pred","g":{"en":"(I) won't let it out","zh":"不会发出"}}]},{"id":"toshishun/2/7","t":[{"f":"鉄冠子[てっかんし]","r":"てっかんし","l":"鉄冠子"},{"f":"は","r":"は","l":"は"},{"f":"うなずく","r":"うなずく","l":"うなずく"},{"f":"なり","r":"なり","l":"なり"},{"f":"、","p":1},{"f":"夜空[よぞら]","r":"よぞら","l":"夜空"},{"f":"の","r":"の","l":"の"},{"f":"中[なか]","r":"なか","l":"中"},{"f":"へ","r":"へ","l":"へ"},{"f":"消[き]えていった","r":"きえていった","l":"消える","i":{"en":"〜ていく: goes on ~ing / away from now + past","zh":"〜ていく：…下去 ＋ 过去式"}},{"f":"。","p":1}],"tr":{"en":"No sooner had Tekkanshi nodded than he vanished into the night sky.","zh":"铁冠子一点头，就消失在了夜空中。"},"say":"てっかんしはうなずくなり、夜空の中へ消えていった。","g":[{"id":"nari","from":2,"to":3}],"n":[{"from":2,"to":3,"body":{"en":"V-dictionary + なり \"as soon as ~, (something unexpected) immediately follows\". The subject of both parts is usually the same person, and it is used for past events in narration.","zh":"动词辞书形＋なり表示“一…就（立刻发生出人意料的事）”。前后主语通常相同，多用于叙述过去的事。"}}],"b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Tekkanshi","zh":"铁冠子"}},{"from":2,"to":3,"r":"time","h":"time","g":{"en":"no sooner had (he) nodded than","zh":"刚一点头"},"n":{"en":"V＋なり \"as soon as V, (then immediately…)\".","zh":"动词原形＋なり表示“一…就…”。"}},{"from":5,"to":8,"r":"goal","h":"goal:へ","g":{"en":"into the night sky","zh":"就往夜空中"}},{"from":9,"to":9,"r":"pred","h":"pred","g":{"en":"vanished","zh":"消失了"}}]}],[{"id":"toshishun/2/8","t":[{"f":"杜子春[とししゅん]","r":"とししゅん","l":"杜子春"},{"f":"が","r":"が","l":"が"},{"f":"一人[ひとり]","r":"ひとり","l":"一人"},{"f":"で","r":"で","l":"で"},{"f":"座[すわ]っている","r":"すわっている","l":"座る","i":{"en":"〜ている: ongoing action or resulting state","zh":"〜ている：动作进行／状态持续"}},{"f"