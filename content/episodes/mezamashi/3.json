ね","l":"よね"},{"f":"？","p":1},{"f":"」","p":1}],"tr":{"en":"\"Er... It's Monday, isn't it?\"","zh":"“啊……？是星期一，对吧？”"},"say":"「え……？月曜日、ですよね？」","who":"sato","b":[{"from":1,"to":1,"r":"call","g":{"en":"er","zh":"呃"}},{"from":4,"to":7,"r":"pred","h":"pred","g":{"en":"it's Monday, isn't it?","zh":"是星期一吧"}}]},{"id":"mezamashi/3/8","t":[{"f":"「","p":1},{"f":"今日[きょう]","r":"きょう","l":"今日"},{"f":"は","r":"は","l":"は"},{"f":"祝日[しゅくじつ]","r":"しゅくじつ","l":"祝日"},{"f":"だ","r":"だ","l":"だ"},{"f":"よ","r":"よ","l":"よ"},{"f":"。","p":1},{"f":"会議[かいぎ]","r":"かいぎ","l":"会議"},{"f":"は","r":"は","l":"は"},{"f":"明日[あした]","r":"あした","l":"明日"},{"f":"だ","r":"だ","l":"だ"},{"f":"」","p":1}],"tr":{"en":"\"Today is a public holiday. The meeting is tomorrow.\"","zh":"“今天是节假日啊。会议是明天。”"},"say":"「今日は祝日だよ。会議は明日だ」","who":"shacho","b":[{"from":1,"to":2,"r":"time","h":"time:は","g":{"en":"as for today","zh":"今天"}},{"from":3,"to":5,"r":"pred","h":"pred","g":{"en":"is a holiday!","zh":"是节假日哦"}},{"from":7,"to":8,"r":"topic","h":"topic:は","g":{"en":"as for the meeting","zh":"会议"}},{"from":9,"to":10,"r":"pred","h":"pred","g":{"en":"is tomorrow","zh":"是明天"}}]}],[{"id":"mezamashi/3/9","t":[{"f":"佐藤[さとう]","r":"さとう","l":"佐藤"},{"f":"さん","r":"さん","l":"さん"},{"f":"は","r":"は","l":"は"},{"f":"力[ちから]","r":"ちから","l":"力"},{"f":"が","r":"が","l":"が"},{"f":"ぬけて","r":"ぬけて","l":"ぬける","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"いす","r":"いす","l":"いす"},{"f":"に","r":"に","l":"に"},{"f":"すわりこみました","r":"すわりこみました","l":"すわりこむ","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"All the strength drained out of Sato, and he sank into a chair.","zh":"佐藤一下子泄了气，瘫坐在椅子上。"},"say":"さとうさんは力がぬけて、いすにすわりこみました。","b":[{"from":0,"to":2,"r":"topic","h":"topic:は","g":{"en":"as for Sato","zh":"佐藤"}},{"from":3,"to":4,"r":"subj","h":"subj:が","g":{"en":"(his) strength","zh":"力气"},"n":{"en":"力がぬける \"strength drains away\", from relief or shock.","zh":"力がぬける“没了力气”，因放心或打击而浑身无力。"}},{"from":5,"to":5,"r":"verb","g":{"en":"drained away, and","zh":"一下子没了"}},{"f