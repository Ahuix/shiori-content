","l":"帰り"},{"f":"、","p":1},{"f":"公園[こうえん]","r":"こうえん","l":"公園"},{"f":"で","r":"で","l":"で"},{"f":"ポチ","r":"ポチ","l":"ポチ"},{"f":"と","r":"と","l":"と"},{"f":"おばあさん","r":"おばあさん","l":"おばあさん"},{"f":"に","r":"に","l":"に"},{"f":"また","r":"また","l":"また"},{"f":"会[あ]いました","r":"あいました","l":"会う","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"On his way home, he met Pochi and the old woman again in the park.","zh":"回家的路上，他在公园里又遇到了波奇和老奶奶。"},"say":"その帰り、公園でポチとおばあさんにまた会いました。","b":[{"from":0,"to":1,"r":"time","h":"time","g":{"en":"on the way back","zh":"回家路上"}},{"from":3,"to":4,"r":"place","h":"place:で","g":{"en":"in the park","zh":"在公园里"}},{"from":5,"to":8,"r":"goal","h":"goal:に","g":{"en":"Pochi and the old woman","zh":"小白和老奶奶"},"n":{"en":"With 会う \"meet\", に marks the person you meet.","zh":"与会う（见面）连用时，に表示见到的人。"}},{"from":9,"to":9,"r":"adv","g":{"en":"again","zh":"又"}},{"from":10,"to":10,"r":"pred","h":"pred","g":{"en":"met","zh":"遇见了"}}]},{"id":"mezamashi/3/15","t":[{"f":"ポチ","r":"ポチ","l":"ポチ"},{"f":"は","r":"は","l":"は"},{"f":"しっぽ","r":"しっぽ","l":"しっぽ"},{"f":"を","r":"を","l":"を"},{"f":"ふって","r":"ふって","l":"ふる","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"佐藤[さとう]","r":"さとう","l":"佐藤"},{"f":"さん","r":"さん","l":"さん"},{"f":"の","r":"の","l":"の"},{"f":"方[ほう]","r":"ほう","l":"方:ほう"},{"f":"へ","r":"へ","l":"へ"},{"f":"走[はし]ってきました","r":"はしってきました","l":"走る","i":{"en":"〜てくる: comes ~ing / has been ~ing + polite past","zh":"〜てくる：…起来／…过来 ＋ 礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"Pochi wagged his tail and came running over to Sato.","zh":"波奇摇着尾巴，朝佐藤跑了过来。"},"say":"ポチはしっぽをふって、さとうさんの方へ走ってきました。","b":[{"from":0,"to":1,"r":"topic","h":"topic:は","g":{"en":"as for Pochi","zh":"小白"}},{"from":2,"to":3,"r":"obj","h":"obj:を","g":{"en":"(his) tail","zh":"尾巴"}},{"from":4,"to":4,"r":"verb","g":{"en":"wagged, and","zh":"摇着"}},{"from":6,"to":10,"r":"goal","h":"goal:へ","g":{"en":"towards Sato","zh":"朝佐藤"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"came running","zh":"跑了过来"}}]},{"id":"mezamashi/