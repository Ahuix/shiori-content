":3,"r":"verb","g":{"en":"sweated, and","zh":"出了"}},{"from":5,"to":6,"r":"subj","h":"subj:も","g":{"en":"(his) shirt too","zh":"衬衫也"}},{"from":7,"to":8,"r":"pred","h":"pred","g":{"en":"is all wrinkled","zh":"皱巴巴的"}}]},{"id":"mezamashi/3/3","t":[{"f":"会議室[かいぎしつ]","r":"かいぎしつ","l":"会議室"},{"f":"の","r":"の","l":"の"},{"f":"ドア","r":"ドア","l":"ドア"},{"f":"を","r":"を","l":"を"},{"f":"開[あ]ける","r":"あける","l":"開ける"},{"f":"と","r":"と","l":"と:when"},{"f":"、","p":1},{"f":"社長[しゃちょう]","r":"しゃちょう","l":"社長"},{"f":"が","r":"が","l":"が"},{"f":"一人[ひとり]","r":"ひとり","l":"一人"},{"f":"で","r":"で","l":"で"},{"f":"すわっていました","r":"すわっていました","l":"すわる","i":{"en":"〜ている: ongoing action or resulting state + polite past","zh":"〜ている：动作进行／状态持续 ＋ 礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"When he opened the meeting-room door, the president was sitting there alone.","zh":"他打开会议室的门，只见社长一个人坐在那里。"},"say":"会議室のドアを開けると、社長が一人ですわっていました。","g":[{"id":"to-conditional","from":4,"to":5}],"b":[{"from":0,"to":5,"r":"cond","h":"cond:と","g":{"en":"when (he) opened the meeting-room door","zh":"一打开会议室的门"}},{"from":7,"to":8,"r":"subj","h":"subj:が","g":{"en":"the president","zh":"社长"}},{"from":9,"to":10,"r":"adv","g":{"en":"alone","zh":"一个人"}},{"from":11,"to":11,"r":"pred","h":"pred","g":{"en":"was sitting","zh":"坐着"}}]},{"id":"mezamashi/3/4","t":[{"f":"「","p":1},{"f":"すみません","r":"すみません","l":"すみません"},{"f":"！","p":1},{"f":"おくれてしまいました","r":"おくれてしまいました","l":"おくれる","i":{"en":"〜てしまう: completely / regrettably + polite past","zh":"〜てしまう：完了／遗憾 ＋ 礼貌体过去式"}},{"f":"！","p":1},{"f":"」","p":1}],"tr":{"en":"\"I'm so sorry! I'm late!\"","zh":"“对不起！我迟到了！”"},"say":"「すみません！おくれてしまいました！」","g":[{"id":"te-shimau","from":3,"to":3}],"who":"sato","b":[{"from":1,"to":1,"r":"call","g":{"en":"I'm sorry","zh":"对不起"}},{"from":3,"to":3,"r":"pred","h":"pred","g":{"en":"(I)'m late","zh":"我迟到了"}}]}],[{"id":"mezamashi/3/5","t":[{"f":"社長[しゃちょう]","r":"しゃちょう","l":"社長"},{"f":"は","r":"は","l":"は"},{"f":"ふしぎそうな","r":"ふしぎそうな","l":"ふしぎ","i":{"en":"looks like (〜そう) + 〜な (before a noun)","