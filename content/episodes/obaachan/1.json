":"は","l":"は"},{"f":"畑[はたけ]","r":"はたけ","l":"畑"},{"f":"が","r":"が","l":"が"},{"f":"あって","r":"あって","l":"ある","i":{"en":"te-form","zh":"て形"}},{"f":"、","p":1},{"f":"後[うし]ろ","r":"うしろ","l":"後ろ"},{"f":"に","r":"に","l":"に"},{"f":"は","r":"は","l":"は"},{"f":"山[やま]","r":"やま","l":"山"},{"f":"が","r":"が","l":"が"},{"f":"あります","r":"あります","l":"ある","i":{"en":"polite","zh":"礼貌体"}},{"f":"。","p":1}],"tr":{"en":"There are fields in front of the house, and mountains behind it.","zh":"房子前面是田地，后面是山。"},"say":"家の前には畑があって、後ろには山があります。","g":[{"id":"aru-iru","from":14,"to":14},{"id":"te-sequence","from":7,"to":7}],"b":[{"from":0,"to":4,"r":"topic","h":"topic:には","g":{"en":"as for in front of the house","zh":"房子前面"}},{"from":5,"to":6,"r":"subj","h":"subj:が","g":{"en":"fields","zh":"田地"}},{"from":7,"to":7,"r":"verb","g":{"en":"there are, and","zh":"有，而"}},{"from":9,"to":11,"r":"topic","h":"topic:には","g":{"en":"as for behind","zh":"后面"},"n":{"en":"家の is left out: 後ろには = 家の後ろには \"behind (the house)\".","zh":"省略了家の：後ろには＝家の後ろには“（房子）后面”。"}},{"from":12,"to":13,"r":"subj","h":"subj:が","g":{"en":"mountains","zh":"山"}},{"from":14,"to":14,"r":"pred","h":"pred","g":{"en":"there are","zh":"有"}}]},{"id":"obaachan/1/6","t":[{"f":"でも","r":"でも","l":"でも"},{"f":"、","p":1},{"f":"近[ちか]く","r":"ちかく","l":"近く"},{"f":"に","r":"に","l":"に"},{"f":"は","r":"は","l":"は"},{"f":"コンビニ","r":"コンビニ","l":"コンビニ"},{"f":"も","r":"も","l":"も"},{"f":"本屋[ほんや]","r":"ほんや","l":"本屋"},{"f":"も","r":"も","l":"も"},{"f":"ありません","r":"ありません","l":"ある","i":{"en":"polite negative","zh":"礼貌体否定"}},{"f":"。","p":1}],"tr":{"en":"But there's no convenience store nearby, and no bookshop either.","zh":"可是附近既没有便利店，也没有书店。"},"say":"でも、近くにはコンビニも本屋もありません。","g":[{"id":"mo-mo","from":5,"to":9}],"n":[{"from":5,"to":5,"body":{"en":"コンビニ is short for コンビニエンスストア \"convenience store\". In a Japanese city there is one on almost every corner.","zh":"コンビニ是コンビニエンスストア“便利店”的简称。日本城市里几乎每个街角都有一家。"}}],"b":[{"from":0,"to":0,"r":"conn","g":{"en":"but","zh":"可是"}},{"from":2,"to":4,"r":"topic","h":"topic:には","g":{"en":"as for nearby","zh":"附近"}},{"from":5,"to":8,"r":"subj","h":"subj:も","g":{"en":"neither a convenience store nor a bookshop","zh":"便利店和书店都"},"n":{"en":"AもBも with a negative: \"neither A nor B\".","zh":"AもBも接否定：“A和B都没有”。"}},{"from":9,"to":9,"r":"pred","h":"pred","g":{"en":"there is","zh":"没有"}}]},{"id":"obaachan/1/7","t":[{"f":"友[とも]だち","r":"ともだち","l":"友だち"},{"f":"も","r":"も","l":"も"},{"f":"いません","r":"いません","l":"いる","i":{"en":"polite negative","zh":"礼貌体否定"}},{"f":"。","p":1}],"tr":{"en":"No friends, either.","zh":"也没有朋友。"},"say":"友だちもいません。","g":[{"id":"mo-also","from":0,"to":1}],"b":[{"from":0,"to":1,"r":"subj","h":"subj:も","g":{"en":"friends too","zh":"朋友也"}},{"from":2,"to":2,"r":"pred","h":"pred","g":{"en":"there aren't","zh":"没有"}}]},{"id":"obaachan/1/8","t":[{"f":"「","p":1},{"f":"つまらない","r":"つまらない","l":"つまらない"},{"f":"なあ","r":"なあ","l":"なあ"},{"f":"」","p":1},{"f":"と","r":"と","l":"と"},{"f":"、","p":1},{"f":"ミオ","r":"ミオ","l":"ミオ"},{"f":"は","r":"は","l":"は"},{"f":"思[おも]いました","r":"おもいました","l":"思う","i":{"en":"polite past","zh":"礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"\"How boring,\" Mio thought.","zh":"美绪心想：“真无聊啊。”"},"say":"「つまらないなあ」と、ミオは思いました。","n":[{"from":2,"to":2,"body":{"en":"なあ at the end shows a feeling you say to yourself, like a sigh.","zh":"句末的なあ表示自言自语般的感叹，像叹气一样。"}}],"who":"mio","b":[{"from":1,"to":4,"r":"quote","h":"quote:と","g":{"en":"\"how boring\"","zh":"“真无聊啊”"}},{"from":6,"to":7,"r":"topic","h":"topic:は","g":{"en":"as for Mio","zh":"美绪"}},{"from":8,"to":8,"r":"pred","h":"pred","g":{"en":"thought","zh":"心想"}}]}],[{"id":"obaachan/1/9","t":[{"f":"夜[よる]","r":"よる","l":"夜"},{"f":"、","p":1},{"f":"外[そと]","r":"そと","l":"外"},{"f":"で","r":"で","l":"で"},{"f":"カエル","r":"カエル","l":"カエル"},{"f":"が","r":"が","l":"が"},{"f":"たくさん","r":"たくさん","l":"たくさん"},{"f":"鳴[な]いていました","r":"ないていました","l":"鳴く","i":{"en":"〜ている: ongoing action or resulting state + polite past","zh":"〜ている：动作进行／状态持续 ＋ 礼貌体过去式"}},{"f":"。","p":1}],"tr":{"en":"At night, lots of frogs were croaking outside.","zh":"晚上，外面有很多青蛙在叫。"},"say":"夜、外でカエルがたくさん鳴いていました。","g":[{"id":"te-iru","from":7,"to":7}],"n":[{"from":7,"to":7,"body":{"en":"鳴く is the sound an animal makes (croak, sing, bark). It sounds the same as 泣く \"cry\".","zh":"鳴く指动物的叫声（蛙叫、鸟鸣、狗叫），和泣く“哭”同音。"}}],"b":[{"from":0,"to":0,"r":"time","h":"time","g":{"en":"at night","zh":"晚上"}},{"from":2,"to":3,"r":"place","h":"place:で","g":{"en":"outside","zh":"在外面"}},{"from":4,"to":5,"r":"subj","h":"subj:が","g":{"en":"frogs","zh":"青蛙"}},{"from":6,"to":6,"r":"adv","g":{"en":"lots","zh":"很多"}},{"from":7,"to":7,"r":"pred","h":"pred","g":{"en":"were croaking","zh":"正在叫"}}]},{"id":"obaachan/1/10","t":[{"f":"「","p":1},{"f":"おばあちゃん","r":"おばあちゃん","l":"おばあちゃん"},{"f":"、","p":1},{"f":"うるさくない","r":"うるさくない","l":"うるさい","i":{"en":"negative","zh":"否定"}},{"f":"？","p":1},{"f":"」","p":1}],"tr":{"en":"\"Grandma, isn't that noisy?\"","zh":"“奶奶，不吵吗？”"},"say":"「おばあちゃん、うるさくない？」","g":[{"id":"adj-negative","from":3,"to":3}],"who":"mio","b":[{"from":1,"to":1,"r":"call","g":{"en":"grandma","zh":"奶奶"}},{"from":3,"to":3,"r":"pred","h":"pred","g":{"en":"isn't (it) noisy?","zh":"不吵吗"},"n":{"en":"A question can be just the negative with a rising voice: うるさくない？ \"isn't it noisy?\".","zh":"用升调说否定形就成了问句：うるさくない？“不吵吗？”"}}]},{"id":"obaachan/1/11","t":[{"f":"「","p":1},{"f":"うるさくない","r":"うるさくない","l":"うるさい","i":{"en":"negative","zh":"否定"}},{"f":"よ","r":"よ","l":"よ"},{"f":"。","p":1},{"f":"カエル","r":"カエル","l":"カエル"},{"f":"の","r":"の","l":"の"},{"f":"歌[うた]","r":"うた","l":"歌"},{"f":"は","r":"は","l":"は"},{"f":"夏[なつ]","r":"なつ","l":"夏"},{"f":"の","r":"の","l":"の"},{"f":"音楽[おんがく]","r":"おんがく","l":"音楽"},{"f":"です","r":"です","l":"です"},{"f":"から","r":"から","l":"から:because"},{"f":"ね","r":"ね","l":"ね"},{"f":"」","p":1}],"tr":{"en":"\"Not at all. The frogs' song is the music of summer.\"","zh":"“不吵啊。青蛙的歌声就是夏天的音乐嘛。”"},"say":"「うるさくないよ。カエルの歌は夏の音楽ですからね」","g":[{"id":"adj-negative","from":1,"to":1},{"id":"kara-reason","from":11,"to":12}],"n":[{"from":12,"to":13,"body":{"en":"Ending a sentence with から giv